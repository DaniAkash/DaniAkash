---
import { cn } from "../utils/cn";

interface Props {
  heading: string;
  description: string;
  /** Button text, defaults to "Subscribe" */
  buttonLabel?: string;
  class?: string;
}

const {
  heading,
  description,
  buttonLabel = "Subscribe",
  class: className,
} = Astro.props;
---

<div
  class={cn(
    "bg-green text-on-green flex flex-col justify-between gap-6 rounded-[1.25rem] p-5 md:rounded-tile md:p-8",
    className,
  )}
>
  <div>
    <h2 class="font-display text-3xl leading-[1.05] font-extrabold tracking-[-0.025em] md:text-4xl">
      {heading}
    </h2>
    <p class="mt-3 max-w-[46ch] text-base leading-relaxed md:text-lg">
      {description}
    </p>
  </div>
  <form
    action="https://buttondown.com/api/emails/embed-subscribe/daniakash"
    method="post"
    target="popupwindow"
    onsubmit="window.open('https://buttondown.com/daniakash', 'popupwindow')"
    class="flex w-full max-w-[520px] flex-col gap-2 sm:flex-row"
  >
    <label class="sr-only" for={`newsletter-email-${heading.length}`}>Email address</label>
    <input
      id={`newsletter-email-${heading.length}`}
      type="email"
      name="email"
      placeholder="you@example.com"
      required
      autocomplete="email"
      class="bg-card text-card-foreground placeholder:text-muted-foreground h-12 w-full min-w-0 sm:flex-1 rounded-full px-5 text-base outline-none focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-[var(--ink)]"
    />
    <button
      type="submit"
      class="bg-ink text-on-ink hover:bg-ink-hover h-12 cursor-pointer rounded-full px-6 text-base font-semibold transition-colors"
    >
      {buttonLabel}
    </button>
  </form>
</div>

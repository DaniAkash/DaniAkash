---
import { cn } from "../utils/cn";

interface Props {
  heading: string;
  description: string;
  /** Button text, defaults to "Subscribe" */
  buttonLabel?: string;
  class?: string;
}

const {
  heading,
  description,
  buttonLabel = "Subscribe",
  class: className,
} = Astro.props;

const inputId = `newsletter-email-${heading.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`;
---

<div
  class={cn(
    "bg-green text-on-bright rounded-widget flex flex-col gap-4 p-4 md:flex-row md:items-center md:gap-6 md:p-5",
    className,
  )}
>
  <div class="min-w-0 flex-1">
    <h2 class="font-display text-title font-extrabold tracking-[-0.02em]">
      {heading}
    </h2>
    <p class="text-body opacity-80">{description}</p>
  </div>
  <form
    action="https://buttondown.com/api/emails/embed-subscribe/daniakash"
    method="post"
    target="popupwindow"
    onsubmit="window.open('https://buttondown.com/daniakash', 'popupwindow')"
    class="flex w-full flex-col gap-2 sm:flex-row md:w-auto"
  >
    <label class="sr-only" for={inputId}>Email address</label>
    <input
      id={inputId}
      type="email"
      name="email"
      placeholder="you@example.com"
      required
      autocomplete="email"
      class="bg-card text-card-foreground placeholder:text-muted-foreground text-body h-11 w-full min-w-0 rounded-full px-4 outline-none focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-[var(--on-bright)] sm:flex-1 md:w-64"
    />
    <button
      type="submit"
      class="bg-on-bright text-label h-11 cursor-pointer rounded-full px-5 font-bold text-white transition-opacity hover:opacity-90"
    >
      {buttonLabel}
    </button>
  </form>
</div>

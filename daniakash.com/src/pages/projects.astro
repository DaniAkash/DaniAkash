---
import { getCollection } from "astro:content";
import Icon from "../components/Icon.astro";
import Tile, { type TileTone } from "../components/Tile.astro";
import { assetUrl } from "../constants/asset-prefix";
import MainLayout from "../layouts/MainLayout.astro";

const projects = (await getCollection("project"))[0]!;
const items = projects.data.items;

type Item = (typeof items)[number];

const spanClasses: Record<Item["size"], string> = {
  "1": "col-span-2 md:col-span-2 lg:col-span-2",
  "2col": "col-span-2 md:col-span-2 lg:col-span-3",
  "3col": "col-span-2 md:col-span-3 lg:col-span-4",
  full: "col-span-2 md:col-span-4 lg:col-span-6",
  stat: "col-span-1 md:col-span-1 lg:col-span-1",
};

const toneFor = (item: Item): TileTone => {
  if (item.size === "stat") return "yellow";
  if (item.size === "full") return "ink";
  if (item.status === "active") return "blue";
  if (item.status === "oss") return "green";
  return "plain";
};

const statusLabel = {
  active: "Active",
  oss: "Open Source",
  previous: "Previously",
} as const;
---

<MainLayout
  title="Projects"
  description="Projects by Dani Akash | from browser extensions to open source libraries to AI agents."
>
  <section
    aria-label="Projects introduction"
    class="grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-5 lg:grid-cols-6"
  >
    <Tile
      as="header"
      class="col-span-2 flex flex-col justify-end gap-2 md:col-span-3 md:min-h-[13rem] lg:col-span-4"
    >
      <h1 class="font-display text-subdisplay md:text-display leading-[1] font-extrabold tracking-[-0.03em]">
        Things I've Built
      </h1>
      <p class="text-muted-foreground text-lede max-w-[44ch] leading-snug">
        From tiny experiments to giant time-sinks, here's what's kept me busy.
      </p>
    </Tile>
    <Tile tone="photo" class="col-span-2 aspect-[16/9] md:col-span-1 md:aspect-auto lg:col-span-2">
      <img
        src={assetUrl("image-2.jpg")}
        alt="Dani Akash coding at his desk with a cat on his lap"
        class="absolute inset-0 size-full object-cover object-[30%_25%]"
        loading="eager"
        decoding="async"
      />
    </Tile>
  </section>

  <section
    aria-label="Projects"
    class="mt-3 grid grid-flow-row-dense grid-cols-2 gap-3 md:mt-5 md:grid-cols-4 md:gap-5 lg:grid-cols-6"
  >
    {
      items.map((item) => {
        const tone = toneFor(item);

        if (item.size === "stat") {
          return (
            <Tile
              tone={tone}
              class={`${spanClasses.stat} flex min-h-[8.5rem] flex-col justify-end`}
            >
              <p class="font-display tabular text-stat leading-none font-extrabold tracking-[-0.03em]">
                {item.stat?.number}
              </p>
              <p class="text-caption mt-1.5 font-semibold">{item.stat?.label}</p>
            </Tile>
          );
        }

        if (item.size === "full") {
          return (
            <Tile
              tone={tone}
              class={`${spanClasses.full} flex flex-col gap-4 md:flex-row md:items-center md:gap-6`}
            >
              <div class="bg-yellow text-on-yellow flex size-10 shrink-0 items-center justify-center rounded-xl">
                <svg
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="size-5"
                >
                  <path d="M12 2 2 7l10 5 10-5-10-5Z" />
                  <path d="m2 17 10 5 10-5" />
                  <path d="m2 12 10 5 10-5" />
                </svg>
              </div>
              <h2 class="font-display text-heading shrink-0 leading-none font-extrabold tracking-[-0.025em]">
                {item.name}
              </h2>
              <p class="text-on-ink-muted text-body max-w-[70ch] leading-relaxed">
                {item.description}
              </p>
            </Tile>
          );
        }

        const isWide = item.size === "3col";

        return (
          <Tile
            {...(item.link
              ? { href: item.link.href, target: "_blank", rel: "noopener" }
              : {})}
            tone={tone}
            class={`${spanClasses[item.size]} flex min-h-[11rem] flex-col gap-2.5`}
          >
            <div class="flex flex-wrap items-start justify-between gap-2">
              <h2
                class:list={[
                  "font-display leading-[1.1] font-bold tracking-[-0.02em]",
                  isWide ? "text-heading" : "text-title",
                ]}
              >
                {item.name}
              </h2>
              {item.status && (
                <span class="bg-current/10 shrink-0 rounded-full px-2.5 py-0.5 text-meta font-semibold">
                  {statusLabel[item.status]}
                </span>
              )}
            </div>
            {item.description && (
              <p
                class:list={[
                  "text-body max-w-[60ch] leading-relaxed",
                  tone === "plain" && "text-muted-foreground",
                  tone !== "plain" && "opacity-90",
                ]}
              >
                {item.description}
              </p>
            )}
            <div class="mt-auto flex flex-wrap items-end justify-between gap-2 pt-1">
              {item.tech && (
                <ul class="flex flex-wrap gap-1" aria-label="Tech">
                  {item.tech.map((t) => (
                    <li class="bg-current/10 rounded-md px-2 py-0.5 text-meta font-medium">
                      {t}
                    </li>
                  ))}
                </ul>
              )}
              {item.link && (
                <span class="text-caption inline-flex items-center gap-1 font-semibold">
                  {item.link.label}
                  <Icon
                    name="arrow-up-right"
                    class="size-3.5 transition-transform duration-300 ease-out-expo group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                  />
                </span>
              )}
            </div>
          </Tile>
        );
      })
    }
  </section>
</MainLayout>

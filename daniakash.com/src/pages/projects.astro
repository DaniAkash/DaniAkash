---
import { getCollection } from "astro:content";
import AppIcon, { type AppIconArt } from "../components/AppIcon.astro";
import AppSheet from "../components/AppSheet.astro";
import Icon from "../components/Icon.astro";
import Widget from "../components/Widget.astro";
import MainLayout from "../layouts/MainLayout.astro";
import { appHref } from "../utils/slugify";

const items = (await getCollection("project"))[0]?.data.items ?? [];

// Project counts stay out of the page; the work speaks for itself.
const projectCounts = new Set(["Libraries Published", "Public Repos"]);
const stats = items.filter(
  (item) => item.size === "stat" && item.stat && !projectCounts.has(item.name),
);
const closing = items.find((item) => item.size === "full");

const groups = [
  {
    id: "apps",
    title: "Apps",
    note: "Things you install, open or visit.",
    category: "app",
  },
  {
    id: "ai-tools",
    title: "AI Tools",
    note: "Agents, skills and the plumbing around them.",
    category: "ai-tool",
  },
  {
    id: "open-source",
    title: "Open Source",
    note: "Libraries, hooks and kits on npm and GitHub.",
    category: "oss",
  },
  {
    id: "earlier",
    title: "Earlier Work",
    note: "Apps, a book, a course and the work that came before.",
    category: "earlier",
  },
].map((group) => ({
  ...group,
  projects: items.filter((item) => item.category === group.category),
}));

const statusLabel = {
  active: "Active",
  oss: "Open Source",
  previous: "Previously",
} as const;

const isExternal = (href: string) => href.startsWith("http");
---

<MainLayout
  title="Projects"
  description="Projects by Dani Akash | from browser extensions to open source libraries to AI agents."
>
  <AppSheet
    title="Things I've Built"
    lede="From tiny experiments to giant time-sinks, here's what's kept me busy."
  >
    <ul
      class="border-border flex flex-wrap gap-x-6 gap-y-2 border-y py-3"
      aria-label="Numbers"
    >
      {
        stats.map((item) => (
          <li class="text-body flex items-baseline gap-1.5">
            <span class="font-display text-title font-extrabold tracking-[-0.02em]">
              {item.stat?.number}
            </span>
            <span class="text-muted-foreground font-semibold">
              {item.stat?.label}
            </span>
          </li>
        ))
      }
    </ul>

    <nav aria-label="Categories" class="mt-6 flex flex-wrap gap-2">
      {
        groups.map((group) => (
          <a
            href={`#${group.id}`}
            class="bg-muted hover:bg-foreground hover:text-background text-label inline-flex min-h-9 items-center rounded-full px-3.5 font-bold transition-colors"
          >
            {group.title}
          </a>
        ))
      }
    </nav>

    <div class="mt-10 flex flex-col gap-12 md:mt-12 md:gap-14">
      {
        groups.map((group) => (
          <section id={group.id} aria-labelledby={`${group.id}-heading`} class="scroll-mt-6">
            <div class="border-border flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 border-b pb-3">
              <h2
                id={`${group.id}-heading`}
                class="font-display text-heading font-extrabold tracking-[-0.025em]"
              >
                {group.title}
              </h2>
              <p class="text-muted-foreground text-label font-semibold">{group.note}</p>
            </div>

            <ul
              class:list={[
                "mt-4 grid gap-x-6 gap-y-1",
                group.category === "app" ? "sm:grid-cols-2" : "md:grid-cols-2",
              ]}
            >
              {group.projects.map((item) => {
                const href = item.icon ? appHref(item.name) : item.link?.href;
                const Tag = href ? "a" : "div";
                const linkProps = href
                  ? {
                      href,
                      target: isExternal(href) ? "_blank" : undefined,
                      rel: isExternal(href) ? "noopener" : undefined,
                    }
                  : {};
                return (
                  <li>
                    <Tag
                      {...linkProps}
                      class="group hover:bg-muted -mx-2 flex items-start gap-4 rounded-2xl p-2 transition-colors"
                    >
                      {item.icon && (
                        <AppIcon
                          art={item.icon as AppIconArt}
                          size="md"
                          class:list={[
                            "group-hover:-translate-y-0.5 group-active:scale-95",
                            group.category === "app" ? "size-[4.5rem]" : "size-14",
                          ]}
                        />
                      )}
                      <div class="min-w-0 flex-1 pt-1.5">
                        <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                          <h3 class="font-display text-title font-extrabold tracking-[-0.02em]">
                            {item.name}
                          </h3>
                          {item.wip && (
                            <span class="text-muted-foreground text-meta inline-flex items-center gap-1.5 font-bold">
                              <span aria-hidden="true" class="bg-wip size-1.5 rounded-full" />
                              In progress
                            </span>
                          )}
                          {item.status && !item.wip && (
                            <span
                              class:list={[
                                "text-meta inline-flex rounded-full px-2 py-0.5 font-bold",
                                item.status === "active"
                                  ? "bg-blue text-on-blue"
                                  : "bg-muted text-muted-foreground group-hover:bg-card",
                              ]}
                            >
                              {statusLabel[item.status]}
                            </span>
                          )}
                        </div>
                        <p class="text-muted-foreground text-body mt-1">{item.description}</p>
                        <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1.5">
                          {item.npm && (
                            <span class="text-caption inline-flex items-center gap-1 font-mono font-semibold">
                              <span class="text-muted-foreground">npm i</span>
                              {item.npm}
                            </span>
                          )}
                          {item.tech && (
                            <ul class="flex flex-wrap gap-1">
                              {item.tech.map((t) => (
                                <li class="bg-muted text-muted-foreground text-meta rounded-full px-2 py-0.5 font-semibold group-hover:bg-card">
                                  {t}
                                </li>
                              ))}
                            </ul>
                          )}
                          {href && (
                            <span class="text-primary text-caption inline-flex items-center gap-1 font-bold">
                              {item.icon ? "Open" : item.link?.label}
                              <Icon
                                name={isExternal(href) ? "arrow-up-right" : "arrow-right"}
                                class="size-3.5 transition-transform duration-300 ease-out-expo group-hover:translate-x-0.5"
                              />
                            </span>
                          )}
                        </div>
                      </div>
                    </Tag>
                  </li>
                );
              })}
            </ul>
          </section>
        ))
      }
    </div>

    {
      closing && (
        <Widget tone="ink" class="mt-12 flex flex-col gap-4 md:flex-row md:items-center md:gap-6">
          <AppIcon
            art={{ kind: "section", glyph: "grid", tint: "#2E5BFF", ink: "#FFFFFF" }}
            size="md"
            class="-m-1.5 size-16"
          />
          <div>
            <h2 class="font-display text-title font-extrabold tracking-[-0.02em]">
              {closing.name}
            </h2>
            <p class="text-on-ink-muted text-body mt-1">{closing.description}</p>
          </div>
        </Widget>
      )
    }
  </AppSheet>
</MainLayout>

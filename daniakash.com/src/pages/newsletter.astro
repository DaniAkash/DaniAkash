---
import { getCollection } from "astro:content";
import Icon from "../components/Icon.astro";
import NewsletterWidget from "../components/Newsletter.astro";
import Tile from "../components/Tile.astro";
import MainLayout from "../layouts/MainLayout.astro";

const rss = (await getCollection("rss")).sort(
  (a, b) => b.data.dateMillis - a.data.dateMillis,
);

const issuesByYear = new Map<number, typeof rss>();
for (const issue of rss) {
  const year = new Date(issue.data.dateValue).getFullYear();
  if (!issuesByYear.has(year)) issuesByYear.set(year, []);
  issuesByYear.get(year)?.push(issue);
}
const years = [...issuesByYear.keys()].sort((a, b) => b - a);
---

<MainLayout
  title="Newsletter"
  description="Dani Akash's newsletter on AI, tech, science, and the web | delivered to your inbox, zero spam."
>
  <header class="grid gap-3 md:grid-cols-2 md:gap-5 lg:grid-cols-6">
    <Tile as="div" class="flex min-h-[8.625rem] flex-col justify-end lg:col-span-3">
      <h1 class="font-display text-subdisplay md:text-display leading-[0.95] font-extrabold tracking-[-0.03em]">
        Letters of the News Kind
      </h1>
      <p class="text-muted-foreground mt-2 max-w-[44ch] text-lede leading-snug">
        Thoughts delivered straight to your inbox, with zero spam (I promise).
      </p>
    </Tile>
    <NewsletterWidget
      heading="Get notified when I publish something new"
      description="Unsubscribe at any time. No spam, ever."
      class="lg:col-span-3"
    />
  </header>

  <Tile
    as="section"
    aria-labelledby="all-issues"
    class="mt-3 grid gap-4 md:mt-5 lg:grid-cols-[9rem_1fr] lg:gap-6"
  >
    <h2
      id="all-issues"
      class="font-display text-heading leading-none font-extrabold tracking-[-0.025em] lg:sticky lg:top-6 lg:self-start"
    >
      All Issues
    </h2>
    <div class="flex flex-col gap-4">
      {
        years.map((year) => {
          const yearIssues = issuesByYear.get(year)!;
          return (
            <section aria-labelledby={`issues-${year}`}>
              <h3
                id={`issues-${year}`}
                class="text-muted-foreground tabular font-mono text-meta font-medium"
              >
                {year}
              </h3>
              <ul class="mt-1">
                {yearIssues.map((issue) => {
                  const date = new Date(issue.data.dateValue);
                  const dateDisplay = date.toLocaleDateString("en-US", {
                    month: "short",
                    day: "numeric",
                  });
                  return (
                    <li class="border-border border-t first:border-t-0">
                      <a
                        href={`/newsletter/${issue.data.slug}/`}
                        class="group/issue hover:bg-tile-hover -mx-2.5 flex items-baseline justify-between gap-5 rounded-xl px-2.5 py-2.5 transition-colors"
                      >
                        <span class="group-hover/issue:text-primary inline-flex items-baseline gap-2 text-body leading-snug font-semibold tracking-[-0.01em] transition-colors">
                          {issue.data.title}
                        </span>
                        <span class="text-muted-foreground inline-flex shrink-0 items-center gap-1.5 font-mono text-meta">
                          <time datetime={issue.data.dateValue}>{dateDisplay}</time>
                          <Icon
                            name="arrow-right"
                            class="hidden size-3.5 transition-transform duration-300 ease-out-expo group-hover/issue:translate-x-1 sm:block"
                          />
                        </span>
                      </a>
                    </li>
                  );
                })}
              </ul>
            </section>
          );
        })
      }
    </div>
  </Tile>
</MainLayout>

---
import { getCollection } from "astro:content";
import AppSheet from "../components/AppSheet.astro";
import NewsletterWidget from "../components/Newsletter.astro";
import MainLayout from "../layouts/MainLayout.astro";

const rss = (await getCollection("rss")).sort(
  (a, b) => b.data.dateMillis - a.data.dateMillis,
);

// Group issues by year
const issuesByYear = new Map<number, typeof rss>();
for (const issue of rss) {
  const year = new Date(issue.data.dateValue).getFullYear();
  if (!issuesByYear.has(year)) issuesByYear.set(year, []);
  issuesByYear.get(year)?.push(issue);
}
const years = [...issuesByYear.keys()].sort((a, b) => b - a);
---

<MainLayout
  title="Newsletter"
  description="Dani Akash's newsletter on AI, tech, science, and the web | delivered to your inbox, zero spam."
>
  <AppSheet
    title="Letters of the News Kind"
    lede="Thoughts delivered straight to your inbox, with zero spam (I promise)."
  >
    <NewsletterWidget
      heading="Get notified when I publish something new"
      description="Unsubscribe at any time. No spam, ever."
      class="ring-border ring-1"
    />

    <section aria-labelledby="all-issues" class="mt-8 md:mt-10">
      <h2
        id="all-issues"
        class="font-display text-title font-extrabold tracking-[-0.02em]"
      >
        All Issues
      </h2>
      <div class="mt-4 flex flex-col gap-6">
        {
          years.map((year) => {
            const yearIssues = issuesByYear.get(year) ?? [];
            return (
              <section
                aria-labelledby={`issues-${year}`}
                class="grid gap-2 md:grid-cols-[8rem_1fr] md:gap-6"
              >
                <h3
                  id={`issues-${year}`}
                  class="text-muted-foreground text-label tabular font-bold md:pt-3.5"
                >
                  {year}
                </h3>
                <ul class="flex flex-col">
                  {yearIssues.map((issue) => {
                    const date = new Date(issue.data.dateValue);
                    const dateDisplay = date.toLocaleDateString("en-US", {
                      month: "short",
                      day: "numeric",
                    });
                    return (
                      <li class="border-border border-t first:border-t-0">
                        <a
                          href={`/newsletter/${issue.data.slug}/`}
                          class="group hover:bg-muted -mx-3 flex items-baseline justify-between gap-6 rounded-2xl px-3 py-3 transition-colors"
                        >
                          <span class="text-lede group-hover:text-primary leading-snug font-bold transition-colors">
                            {issue.data.title}
                          </span>
                          <time
                            datetime={issue.data.dateValue}
                            class="text-muted-foreground text-meta tabular shrink-0 font-semibold"
                          >
                            {dateDisplay}
                          </time>
                        </a>
                      </li>
                    );
                  })}
                </ul>
              </section>
            );
          })
        }
      </div>
    </section>
  </AppSheet>
</MainLayout>

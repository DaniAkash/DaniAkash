---
import { getCollection } from "astro:content";
import type { GetStaticPaths } from "astro";
import AppSheet from "../../components/AppSheet.astro";
import Icon from "../../components/Icon.astro";
import Newsletter from "../../components/Newsletter.astro";
import { ASSET_PREFIX } from "../../constants/asset-prefix";
import MainLayout from "../../layouts/MainLayout.astro";
import { getOGImage } from "../../utils/getOGImage";

export const getStaticPaths = (async () => {
  const items = (await getCollection("rss")).sort(
    (a, b) => b.data.dateMillis - a.data.dateMillis,
  );

  return items.map((each, index) => {
    const prev = items[index + 1] ?? null;
    const next = items[index - 1] ?? null;
    return {
      params: { slug: each.data.slug },
      props: {
        content: each.data.description,
        dateValue: each.data.dateValue,
        dateDisplay: each.data.dateDisplay,
        title: each.data.title,
        canonical: each.data.canonical,
        prev: prev ? { slug: prev.data.slug, title: prev.data.title } : null,
        next: next ? { slug: next.data.slug, title: next.data.title } : null,
      },
    };
  });
}) satisfies GetStaticPaths;

const { content, dateValue, dateDisplay, title, canonical, prev, next } =
  Astro.props;

// Extract unique description from issue content, fallback to generic
const fallbackDescription =
  "Dani Akash's newsletter on AI, tech, science, and the web | delivered to your inbox.";
const plainText = content
  .replace(/<[^>]+>/g, " ")
  .replace(/&[a-z]+;/gi, " ")
  .replace(/\s+/g, " ")
  .trim();
const description =
  plainText.length > 150
    ? plainText.substring(0, 150).replace(/\s+\S*$/, "") + "..."
    : plainText.length > 10
      ? plainText
      : fallbackDescription;
const { slug } = Astro.params;
const image = `/og/newsletter/${slug}.png`;
await getOGImage({
  title: title,
  description,
  path: image,
  cover: `${ASSET_PREFIX}/newsletter/icon.png`,
});
---

<MainLayout
  title={title}
  description={description}
  image={image}
  canonical={canonical}
>
  <div id="article">
    <AppSheet title={title} sectionHref="/newsletter/" class="max-w-[60rem]">
      <p
        slot="header"
        class="text-muted-foreground text-label mt-3 flex flex-wrap items-center gap-x-2 font-semibold"
      >
        <span>Newsletter</span>
        <span aria-hidden="true">·</span>
        <time datetime={dateValue} class="tabular">{dateDisplay}</time>
      </p>

      <div class="border-border border-t pt-6 md:pt-8">
        <div
          class="prose dark:prose-invert mx-auto max-w-[68ch]"
          set:html={content}
        />
      </div>

      <nav
        aria-label="Issue navigation"
        class="border-border mt-10 grid gap-2 border-t pt-6 sm:grid-cols-2"
      >
        {
          prev ? (
            <a
              href={`/newsletter/${prev.slug}/`}
              class="bg-muted hover:bg-foreground hover:text-background group flex items-center gap-3 rounded-2xl px-4 py-3 transition-colors"
            >
              <Icon name="chevron-left" class="size-4 shrink-0" />
              <span class="min-w-0">
                <span class="text-meta block font-semibold opacity-70">
                  Previous issue
                </span>
                <span class="text-label block truncate font-bold">
                  {prev.title}
                </span>
              </span>
            </a>
          ) : (
            <span class="hidden sm:block" />
          )
        }
        {
          next && (
            <a
              href={`/newsletter/${next.slug}/`}
              class="bg-muted hover:bg-foreground hover:text-background group flex items-center justify-end gap-3 rounded-2xl px-4 py-3 text-right transition-colors"
            >
              <span class="min-w-0">
                <span class="text-meta block font-semibold opacity-70">
                  Next issue
                </span>
                <span class="text-label block truncate font-bold">
                  {next.title}
                </span>
              </span>
              <Icon name="arrow-right" class="size-4 shrink-0" />
            </a>
          )
        }
      </nav>
      <a
        href="/newsletter/"
        class="bg-muted hover:bg-foreground hover:text-background text-label mt-3 inline-flex min-h-10 items-center gap-1.5 rounded-full px-4 font-bold transition-colors"
      >
        <Icon name="chevron-left" class="size-4" />
        Back to newsletter
      </a>
    </AppSheet>
  </div>

  <Newsletter
    heading="Enjoyed this issue?"
    description="Subscribe to get future issues delivered to your inbox."
    class="mx-auto mt-4 max-w-[60rem] md:mt-5"
  />
</MainLayout>

<script is:inline>
  document.addEventListener("astro:page-load", function () {
    if (window.__readingProgressCleanup) window.__readingProgressCleanup();

    var article = document.getElementById("article");
    if (!article) return;

    var existing = document.getElementById("readingProgress");
    if (existing) existing.remove();

    var container = document.createElement("div");
    container.id = "readingProgress";
    container.style.cssText =
      "position:fixed;top:0;left:0;right:0;height:3px;z-index:9999;pointer-events:none;";
    var bar = document.createElement("div");
    bar.style.cssText =
      "height:100%;width:0;background:var(--blue);transition:none;";
    container.appendChild(bar);
    document.body.appendChild(container);

    var animId;
    function update() {
      var rect = article.getBoundingClientRect();
      var total = rect.height - window.innerHeight;
      if (total <= 0) {
        bar.style.width = "100%";
        return;
      }
      var pct = Math.max(0, Math.min(100, (-rect.top / total) * 100));
      bar.style.width = pct + "%";
      animId = requestAnimationFrame(update);
    }
    animId = requestAnimationFrame(update);

    window.__readingProgressCleanup = function () {
      cancelAnimationFrame(animId);
      var el = document.getElementById("readingProgress");
      if (el) el.remove();
    };
  });
</script>

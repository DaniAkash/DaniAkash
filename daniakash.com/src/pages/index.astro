---
import { getCollection } from "astro:content";
import GlobeMini from "../components/GlobeMini";
import Icon, { type IconName } from "../components/Icon.astro";
import Newsletter from "../components/Newsletter.astro";
import Tile from "../components/Tile.astro";
import { assetUrl } from "../constants/asset-prefix";
import MainLayout from "../layouts/MainLayout.astro";

const posts = (await getCollection("blog"))
  .sort(
    (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
  )
  .slice(0, 11);
const latestPosts = posts.slice(0, 3);
const morePosts = posts.slice(3);

const career = await getCollection("career");
const experience = career[0]?.data?.items ?? [];

const social = await getCollection("social");
const socialData = social[0]?.data;

const projectItems = (await getCollection("project"))[0]?.data.items ?? [];
const starsStat = projectItems.find((item) => item.name === "GitHub Stars")
  ?.stat ?? { number: "473+", label: "GitHub Stars" };

const speakingGroups = await getCollection("speaking");
const talkCount = speakingGroups.reduce(
  (total, group) => total + group.data.events.length,
  0,
);
const firstTalkYear = Math.min(
  ...speakingGroups.map((group) => group.data.year),
);

const destinations = (await getCollection("destinations"))[0]?.data.items ?? [];
const globeMarkers = destinations.map(
  (d) => [d.lat, d.lng] as [number, number],
);

const email = socialData?.email ?? "hello@daniakash.com";

const connectLinks: {
  platform: string;
  handle: string;
  href: string;
  icon: IconName;
}[] = [
  {
    platform: "GitHub",
    handle: "@DaniAkash",
    href: socialData?.github ?? "https://github.com/DaniAkash",
    icon: "github",
  },
  {
    platform: "X / Twitter",
    handle: "@dani_akash_",
    href: socialData?.twitter ?? "https://x.com/dani_akash_",
    icon: "x",
  },
  {
    platform: "Bluesky",
    handle: "@daniakash.com",
    href: socialData?.bluesky ?? "https://bsky.app/profile/daniakash.com",
    icon: "bluesky",
  },
  {
    platform: "LinkedIn",
    handle: "Dani Akash",
    href: socialData?.linkedIn ?? "https://www.linkedin.com/in/daniakash",
    icon: "linkedin",
  },
  {
    platform: "Instagram",
    handle: "@dani_akash_",
    href: socialData?.instagram ?? "https://www.instagram.com/dani_akash_",
    icon: "instagram",
  },
  {
    platform: "Email",
    handle: email,
    href: `mailto:${email}`,
    icon: "mail",
  },
];

const photos = {
  cosplay: {
    src: assetUrl("image-1.jpg"),
    alt: "Dani Akash posing with a cosplayer in a fighting stance",
  },
  cat: {
    src: assetUrl("image-2.jpg"),
    alt: "Dani Akash coding at his desk with a cat on his lap",
  },
  talk: {
    src: assetUrl("image-3.jpg"),
    alt: "Dani Akash speaking at a tech meetup with a microphone",
  },
  hike: {
    src: assetUrl("image-4.jpg"),
    alt: "Dani Akash overlooking a river gorge on a hike",
  },
  market: {
    src: assetUrl("image-5.jpg"),
    alt: "Dani Akash examining a large decorative sculpture at a market",
  },
};

const formatDate = (value: string) => {
  const date = new Date(value);
  return `${date.getFullYear()}.${String(date.getMonth() + 1).padStart(2, "0")}.${String(date.getDate()).padStart(2, "0")}`;
};

const isExternal = (href: string) => href.startsWith("http");
---

<MainLayout title="">
  <!-- First viewport bento -->
  <section
    aria-label="Introduction"
    class="grid grid-flow-row-dense grid-cols-2 gap-3 md:grid-cols-4 md:gap-4 lg:grid-cols-6 lg:grid-rows-[repeat(4,minmax(11.25rem,auto))]"
  >
    <Tile
      as="div"
      class="col-span-2 flex flex-col justify-between gap-8 md:col-span-2 lg:row-span-2"
    >
      <img
        src={photos.cat.src}
        alt=""
        width="80"
        height="80"
        class="size-16 rounded-full object-cover object-[30%_20%] md:size-20"
        loading="eager"
        decoding="async"
      />
      <div>
        <h1 class="font-display text-[clamp(2.75rem,4.6vw,4.5rem)] leading-[0.95] font-extrabold tracking-[-0.035em]">
          Hi, I’m Dani Akash.
        </h1>
        <p class="mt-4 text-lg font-semibold md:text-xl">
          AI Engineer · Builder · Speaker
        </p>
        <p class="text-muted-foreground mt-2 max-w-[34ch] text-lg leading-snug md:text-xl">
          A simple developer building AI agents for humans.
        </p>
      </div>
    </Tile>

    <Tile
      tone="photo"
      class="col-span-2 aspect-[4/3] md:col-span-2 md:aspect-auto lg:row-span-2"
    >
      <img
        src={photos.talk.src}
        alt={photos.talk.alt}
        class="absolute inset-0 size-full object-cover object-[60%_40%]"
        loading="eager"
        decoding="async"
      />
    </Tile>

    <Tile
      href="/projects/"
      tone="blue"
      class="col-span-2 flex min-h-[11.25rem] flex-col justify-end gap-6"
    >
      <div class="flex flex-col items-start gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div class="min-w-0">
          <h2 class="font-display flex items-center gap-2.5 text-3xl leading-none font-extrabold tracking-[-0.025em] 2xl:text-4xl">
            BrowserOS
            <span class="bg-on-blue size-2.5 animate-pulse rounded-full" aria-hidden="true"></span>
          </h2>
          <p class="mt-2 text-[15px] opacity-90">
            Building now: an AI-powered browser for agents
          </p>
        </div>
        <span class="bg-on-blue text-blue inline-flex shrink-0 items-center gap-2 rounded-full px-4 py-2.5 text-sm font-semibold transition-transform duration-300 ease-out-expo group-hover:translate-x-1">
          Explore the work <Icon name="arrow-right" class="size-4" />
        </span>
      </div>
    </Tile>

    <Tile
      href={socialData?.github ?? "https://github.com/DaniAkash"}
      target="_blank"
      rel="noopener"
      tone="yellow"
      class="flex min-h-[11.25rem] flex-col justify-between"
    >
      <Icon name="github" class="size-6" />
      <div>
        <p class="font-display tabular text-5xl leading-none font-extrabold tracking-[-0.03em] md:text-[3.5rem]">
          {starsStat.number}
        </p>
        <p class="mt-2 text-sm font-semibold">{starsStat.label}</p>
      </div>
    </Tile>

    <Tile tone="photo" class="min-h-[11.25rem]">
      <img
        src={photos.cosplay.src}
        alt={photos.cosplay.alt}
        class="absolute inset-0 size-full object-cover object-[40%_30%]"
        loading="eager"
        decoding="async"
      />
    </Tile>

    <Tile
      as="section"
      aria-labelledby="latest-writing"
      class="col-span-2 flex flex-col md:col-span-2 lg:row-span-2"
    >
      <div class="flex items-baseline justify-between gap-4">
        <h2
          id="latest-writing"
          class="font-display text-2xl font-bold tracking-[-0.02em]"
        >
          Latest writing
        </h2>
        <a
          href="/blog/"
          class="text-muted-foreground hover:text-foreground inline-flex min-h-11 shrink-0 items-center gap-1 text-sm font-medium whitespace-nowrap transition-colors"
        >
          View all posts <Icon name="arrow-right" class="size-4" />
        </a>
      </div>
      <ul class="mt-2 flex flex-1 flex-col">
        {
          latestPosts.map((post) => (
            <li class="border-border border-t first:border-t-0">
              <a
                href={`/posts/${post.id}/`}
                class="group/post hover:text-primary flex flex-col gap-1 py-3.5 transition-colors"
              >
                <time
                  datetime={new Date(post.data.date).toISOString()}
                  class="text-muted-foreground font-mono text-xs"
                >
                  {formatDate(post.data.date)}
                </time>
                <span class="text-[17px] leading-snug font-semibold">
                  {post.data.title}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </Tile>

    <Tile tone="photo" class="aspect-[3/4] md:aspect-auto lg:row-span-2">
      <img
        src={photos.hike.src}
        alt={photos.hike.alt}
        class="absolute inset-0 size-full object-cover object-[70%_50%]"
        loading="lazy"
        decoding="async"
      />
    </Tile>

    <Tile
      href="/about/"
      tone="ink"
      class="col-span-2 flex min-h-[11.25rem] items-center gap-5 py-4 md:col-span-2"
    >
      <div class="w-28 shrink-0 md:w-36" aria-hidden="true">
        <GlobeMini client:visible markers={globeMarkers} />
      </div>
      <div>
        <h2 class="font-display text-2xl leading-tight font-bold tracking-[-0.02em] md:text-[1.75rem]">
          {destinations.length} places on my globe
        </h2>
        <p class="text-on-ink-muted mt-1 inline-flex items-center gap-1 text-sm font-medium">
          Spin it on the about page <Icon name="arrow-right" class="size-4 transition-transform duration-300 ease-out-expo group-hover:translate-x-1" />
        </p>
      </div>
    </Tile>

    <Tile
      href="/speaking/"
      tone="pink"
      class="flex min-h-[11.25rem] flex-col justify-between lg:row-span-2"
    >
      <h2 class="text-sm font-semibold">Talks since {firstTalkYear}</h2>
      <div>
        <p class="font-display tabular text-6xl leading-none font-extrabold tracking-[-0.03em] md:text-7xl">
          {talkCount}
        </p>
        <p class="mt-3 inline-flex items-center gap-1 text-sm font-semibold">
          See every talk <Icon name="arrow-right" class="size-4 transition-transform duration-300 ease-out-expo group-hover:translate-x-1" />
        </p>
      </div>
    </Tile>

    <Tile href="/now/" class="flex min-h-[11.25rem] flex-col justify-between">
      <span class="bg-blue size-2.5 animate-pulse rounded-full" aria-hidden="true"></span>
      <div>
        <h2 class="font-display text-2xl font-bold tracking-[-0.02em]">Now</h2>
        <p class="text-muted-foreground mt-1 inline-flex items-center gap-1 text-sm font-medium">
          What I’m up to <Icon name="arrow-right" class="size-4 transition-transform duration-300 ease-out-expo group-hover:translate-x-1" />
        </p>
      </div>
    </Tile>

    <Tile href="/uses/" class="flex min-h-[11.25rem] flex-col justify-end">
      <h2 class="font-display text-2xl font-bold tracking-[-0.02em]">Uses</h2>
      <p class="text-muted-foreground mt-1 inline-flex items-center gap-1 text-sm font-medium">
        My desk and tools <Icon name="arrow-right" class="size-4 transition-transform duration-300 ease-out-expo group-hover:translate-x-1" />
      </p>
    </Tile>
  </section>

  <!-- Second band: more writing, work, speaking, connect -->
  <section
    aria-label="Writing and work"
    class="mt-3 grid grid-cols-2 gap-3 md:mt-4 md:grid-cols-4 md:gap-4 lg:grid-cols-6"
    id="work"
  >
    <Tile as="section" aria-labelledby="more-writing" class="col-span-2 md:col-span-4">
      <h2
        id="more-writing"
        class="font-display text-2xl font-bold tracking-[-0.02em] md:text-3xl"
      >
        More from the blog
      </h2>
      <ul class="mt-2">
        {
          morePosts.map((post) => (
            <li class="border-border border-t first:border-t-0">
              <a
                href={`/posts/${post.id}/`}
                class="group/post hover:text-primary grid grid-cols-[5.5rem_1fr_auto] items-baseline gap-4 py-3.5 transition-colors sm:grid-cols-[7rem_1fr_auto]"
              >
                <time
                  datetime={new Date(post.data.date).toISOString()}
                  class="text-muted-foreground font-mono text-xs"
                >
                  {formatDate(post.data.date)}
                </time>
                <span class="text-base leading-snug font-semibold">
                  {post.data.title}
                </span>
                <Icon
                  name="arrow-right"
                  class="text-muted-foreground hidden size-4 transition-transform duration-300 ease-out-expo group-hover/post:translate-x-1 sm:block"
                />
              </a>
            </li>
          ))
        }
      </ul>
    </Tile>

    <Tile as="section" aria-labelledby="work-heading" class="col-span-2 flex flex-col lg:row-span-2">
      <h2
        id="work-heading"
        class="font-display text-2xl font-bold tracking-[-0.02em] md:text-3xl"
      >
        Work
      </h2>
      <ul class="mt-3 flex flex-1 flex-col justify-between">
        {
          experience.map((job) => (
            <li class="border-border flex items-center gap-3 border-t py-3 first:border-t-0">
              <img
                src={assetUrl(job.logo)}
                alt=""
                width="40"
                height="40"
                loading="lazy"
                class="bg-muted size-10 shrink-0 rounded-xl object-contain p-1.5"
              />
              <div class="min-w-0 flex-1">
                <p class="truncate font-semibold">{job.company}</p>
                <p class="text-muted-foreground truncate text-sm">{job.role}</p>
              </div>
              <span class="text-muted-foreground shrink-0 text-right font-mono text-xs">
                {job.startDate}
                <br />
                {job.endDate}
              </span>
            </li>
          ))
        }
      </ul>
      <a
        href="/resume/"
        class="bg-foreground text-background hover:bg-primary hover:text-primary-foreground mt-4 inline-flex min-h-12 items-center justify-center gap-2 rounded-full px-5 font-semibold transition-colors"
      >
        Resume <Icon name="arrow-right" class="size-4" />
      </a>
    </Tile>

    <Tile as="section" aria-labelledby="speaking-heading" tone="pink" class="col-span-2 flex flex-col justify-between gap-6">
      <h2
        id="speaking-heading"
        class="font-display text-2xl font-bold tracking-[-0.02em] md:text-3xl"
      >
        Speaking
      </h2>
      <p class="text-[17px] leading-relaxed">
        I regularly speak at community meetups and conferences about AI,
        JavaScript, React Native, and the web. I've given 25+ talks since 2017
        across events like React Nexus, JSLovers, Thoughtworks Geeknight, React
        Bangalore, and more.
      </p>
      <a
        href="/speaking/"
        class="bg-ink text-on-ink hover:bg-ink-hover inline-flex min-h-12 items-center justify-center gap-2 self-start rounded-full px-5 font-semibold transition-colors"
      >
        View all talks <Icon name="arrow-right" class="size-4" />
      </a>
    </Tile>

    <Tile tone="photo" class="col-span-2 aspect-[16/9] md:col-span-4 lg:col-span-2 lg:aspect-auto">
      <img
        src={photos.market.src}
        alt={photos.market.alt}
        class="absolute inset-0 size-full object-cover"
        loading="lazy"
        decoding="async"
      />
    </Tile>

    <Tile as="section" aria-labelledby="connect-heading" class="col-span-2 md:col-span-4 lg:col-span-6">
      <h2
        id="connect-heading"
        class="font-display text-2xl font-bold tracking-[-0.02em] md:text-3xl"
      >
        Connect
      </h2>
      <ul class="mt-4 grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
        {
          connectLinks.map((link) => (
            <li>
              <a
                href={link.href}
                target={isExternal(link.href) ? "_blank" : undefined}
                rel={isExternal(link.href) ? "noopener" : undefined}
                class="bg-muted hover:bg-foreground hover:text-background flex min-h-14 items-center gap-3 rounded-2xl px-4 py-2.5 transition-colors"
              >
                <Icon name={link.icon} />
                <span class="min-w-0">
                  <span class="block text-xs font-medium opacity-70">
                    {link.platform}
                  </span>
                  <span class="block truncate font-semibold">{link.handle}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </Tile>

    <Newsletter
      heading="Stay in the loop"
      description="Thoughts delivered straight to your inbox. Zero spam, I promise."
      class="col-span-2 md:col-span-4 lg:col-span-6 lg:flex-row lg:items-end"
    />
  </section>
</MainLayout>

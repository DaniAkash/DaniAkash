---
import { getCollection } from "astro:content";
import AppIcon, { type AppIconArt } from "../components/AppIcon.astro";
import Folder, { type FolderApp } from "../components/Folder.astro";
import Icon, { type IconName } from "../components/Icon.astro";
import Newsletter from "../components/Newsletter.astro";
import Widget from "../components/Widget.astro";
import { assetUrl } from "../constants/asset-prefix";
import MainLayout from "../layouts/MainLayout.astro";

const posts = (await getCollection("blog"))
  .sort(
    (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
  )
  .slice(0, 11);
const latestPosts = posts.slice(0, 4);
const morePosts = posts.slice(4);

const experience = (await getCollection("career"))[0]?.data?.items ?? [];
const socialData = (await getCollection("social"))[0]?.data;

const projects = (await getCollection("project"))[0]?.data.items ?? [];
const starsStat = projects.find((p) => p.name === "GitHub Stars")?.stat ?? {
  number: "473+",
  label: "GitHub Stars",
};

const toApp = (p: (typeof projects)[number]): FolderApp | undefined =>
  p.icon && p.link
    ? {
        name: p.name,
        href: p.link.href,
        description: p.description,
        art: p.icon as AppIconArt,
      }
    : undefined;

const byName = (name: string) => {
  const project = projects.find((p) => p.name === name);
  return project ? toApp(project) : undefined;
};

const inCategory = (category: string) =>
  projects
    .filter((p) => p.category === category)
    .map(toApp)
    .filter((app): app is FolderApp => Boolean(app));

const homeApps = [
  { app: byName("BrowserOS"), lg: "lg:col-start-4 lg:row-start-1" },
  { app: byName("aalai"), lg: "lg:col-start-5 lg:row-start-1" },
  { app: byName("Agent Terminal"), lg: "lg:col-start-6 lg:row-start-1" },
  { app: byName("herbie"), lg: "lg:col-start-4 lg:row-start-2" },
  { app: byName("Screen Time Overlay"), lg: "lg:col-start-5 lg:row-start-2" },
  { app: byName("stylecn"), lg: "lg:col-start-6 lg:row-start-2" },
  {
    app: byName("Google Rust Style Guide"),
    lg: "lg:col-start-1 lg:row-start-3",
  },
];

const folders = [
  {
    id: "folder-ai-tools",
    title: "AI Tools",
    apps: inCategory("ai-tool"),
    lg: "lg:col-start-2 lg:row-start-3",
  },
  {
    id: "folder-open-source",
    title: "Open Source",
    apps: inCategory("oss"),
    lg: "lg:col-start-3 lg:row-start-3",
  },
  {
    id: "folder-earlier",
    title: "Earlier Work",
    apps: inCategory("earlier"),
    lg: "lg:col-start-4 lg:row-start-3",
  },
];

const speakingGroups = await getCollection("speaking");
const talkCount = speakingGroups.reduce(
  (total, group) => total + group.data.events.length,
  0,
);
const firstTalkYear = Math.min(...speakingGroups.map((g) => g.data.year));

const email = socialData?.email ?? "hello@daniakash.com";

const connectLinks: {
  platform: string;
  handle: string;
  href: string;
  icon: IconName;
}[] = [
  {
    platform: "GitHub",
    handle: "@DaniAkash",
    href: socialData?.github ?? "https://github.com/DaniAkash",
    icon: "github",
  },
  {
    platform: "X / Twitter",
    handle: "@dani_akash_",
    href: socialData?.twitter ?? "https://x.com/dani_akash_",
    icon: "x",
  },
  {
    platform: "Bluesky",
    handle: "@daniakash.com",
    href: socialData?.bluesky ?? "https://bsky.app/profile/daniakash.com",
    icon: "bluesky",
  },
  {
    platform: "LinkedIn",
    handle: "Dani Akash",
    href: socialData?.linkedIn ?? "https://www.linkedin.com/in/daniakash",
    icon: "linkedin",
  },
  {
    platform: "Instagram",
    handle: "@dani_akash_",
    href: socialData?.instagram ?? "https://www.instagram.com/dani_akash_",
    icon: "instagram",
  },
  {
    platform: "Email",
    handle: email,
    href: `mailto:${email}`,
    icon: "mail",
  },
];

const photos = {
  cosplay: {
    src: assetUrl("image-1.jpg"),
    alt: "Dani Akash posing with a cosplayer in a fighting stance",
  },
  cat: {
    src: assetUrl("image-2.jpg"),
    alt: "Dani Akash coding at his desk with a cat on his lap",
  },
  talk: {
    src: assetUrl("image-3.jpg"),
    alt: "Dani Akash speaking at a tech meetup with a microphone",
  },
  hike: {
    src: assetUrl("image-4.jpg"),
    alt: "Dani Akash overlooking a river gorge on a hike",
  },
  market: {
    src: assetUrl("image-5.jpg"),
    alt: "Dani Akash examining a large decorative sculpture at a market",
  },
};

const formatDate = (value: string) => {
  const date = new Date(value);
  return `${date.getFullYear()}.${String(date.getMonth() + 1).padStart(2, "0")}.${String(date.getDate()).padStart(2, "0")}`;
};

const isExternal = (href: string) => href.startsWith("http");
---

<MainLayout title="">
  <section
    aria-label="Home screen"
    class="grid grid-flow-row-dense auto-rows-[minmax(6.75rem,auto)] grid-cols-4 gap-x-2 gap-y-3 sm:grid-cols-6 md:gap-x-4 md:gap-y-4 lg:grid-cols-8 lg:auto-rows-[7.5rem]"
  >
    <Widget
      as="div"
      class="col-span-4 row-span-2 flex flex-col justify-between sm:col-span-3 lg:col-span-3 lg:col-start-1 lg:row-span-2 lg:row-start-1"
    >
      <div class="flex items-center justify-between gap-3">
        <img
          src={photos.cat.src}
          alt=""
          width="56"
          height="56"
          class="size-12 rounded-full object-cover object-[30%_20%] md:size-14"
          loading="eager"
          decoding="async"
        />
        <ul class="flex gap-0.5" aria-label="Social links">
          {
            connectLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  aria-label={link.platform}
                  title={link.platform}
                  target={isExternal(link.href) ? "_blank" : undefined}
                  rel={isExternal(link.href) ? "noopener" : undefined}
                  class="text-muted-foreground hover:bg-muted hover:text-foreground inline-flex size-9 items-center justify-center rounded-full transition-colors"
                >
                  <Icon name={link.icon} class="size-4" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h1 class="font-display text-heading md:text-display font-extrabold tracking-[-0.03em]">
          Dani Akash
        </h1>
        <p class="text-label mt-2 font-bold">AI Engineer · Builder · Speaker</p>
        <p class="text-muted-foreground text-body mt-0.5">
          A simple developer building AI agents for humans.
        </p>
      </div>
    </Widget>

    {
      homeApps.map(
        ({ app, lg }) =>
          app && (
            <a
              href={app.href}
              target={isExternal(app.href) ? "_blank" : undefined}
              rel={isExternal(app.href) ? "noopener" : undefined}
              title={app.description}
              class:list={[
                "group flex flex-col items-center justify-start gap-1.5 pt-1",
                lg,
              ]}
            >
              <AppIcon
                art={app.art}
                size="lg"
                class="size-[4.5rem] group-hover:-translate-y-1 group-active:scale-90 md:size-[5.5rem]"
              />
              <span class="text-label max-w-[6.5rem] text-center leading-tight font-semibold">
                {app.name}
              </span>
            </a>
          ),
      )
    }

    <Widget
      tone="photo"
      class="col-span-4 row-span-2 sm:col-span-3 lg:col-span-2 lg:col-start-7 lg:row-span-2 lg:row-start-1"
    >
      <img
        src={photos.talk.src}
        alt={photos.talk.alt}
        class="absolute inset-0 size-full object-cover object-[60%_40%]"
        loading="eager"
        decoding="async"
      />
    </Widget>

    {
      folders.map((folder) => (
        <div class:list={["flex justify-center pt-1", folder.lg]}>
          <Folder id={folder.id} title={folder.title} apps={folder.apps} />
        </div>
      ))
    }

    <Widget
      href="/projects/"
      tone="blue"
      class="col-span-4 flex flex-col justify-between sm:col-span-4 lg:col-span-3 lg:col-start-5 lg:row-start-3"
    >
      <span class="bg-on-blue size-2 animate-pulse rounded-full" aria-hidden="true"></span>
      <div class="flex items-end justify-between gap-3">
        <p class="text-body leading-snug font-semibold">
          <span class="font-display text-title block font-extrabold tracking-[-0.02em]">
            BrowserOS
          </span>
          Building now: an AI-powered browser for agents
        </p>
        <span
          class="bg-on-blue text-blue text-caption inline-flex shrink-0 items-center gap-1 rounded-full px-3 py-1.5 font-bold whitespace-nowrap transition-transform duration-300 ease-out-expo group-hover:translate-x-0.5"
        >
          Explore the work <Icon name="arrow-right" class="size-3.5" />
        </span>
      </div>
    </Widget>

    <Widget
      href={socialData?.github ?? "https://github.com/DaniAkash"}
      target="_blank"
      rel="noopener"
      class="col-span-2 flex flex-col justify-between lg:col-span-1 lg:col-start-8 lg:row-start-3"
    >
      <Icon name="github" class="size-4" />
      <div>
        <p class="font-display text-title font-extrabold tracking-[-0.02em]">
          {starsStat.number}
        </p>
        <p class="text-muted-foreground text-meta font-semibold">
          {starsStat.label}
        </p>
      </div>
    </Widget>

    <Widget
      href="/speaking/"
      tone="ink"
      class="col-span-2 flex flex-col justify-between lg:col-span-2 lg:col-start-1 lg:row-start-4"
    >
      <span class="text-on-ink-muted text-caption font-bold">
        Talks since {firstTalkYear}
      </span>
      <div class="flex items-end justify-between">
        <p class="font-display text-stat font-extrabold tracking-[-0.03em]">
          {talkCount}
        </p>
        <Icon
          name="arrow-right"
          class="mb-1 size-4 transition-transform duration-300 ease-out-expo group-hover:translate-x-0.5"
        />
      </div>
    </Widget>

    <Widget
      tone="photo"
      class="col-span-2 row-span-3 lg:col-span-2 lg:col-start-1 lg:row-span-1 lg:row-start-5"
    >
      <img
        src={photos.hike.src}
        alt={photos.hike.alt}
        class="absolute inset-0 size-full object-cover object-[70%_55%]"
        loading="lazy"
        decoding="async"
      />
    </Widget>

    <Widget
      tone="photo"
      class="col-span-2 row-span-2 lg:col-span-2 lg:col-start-3 lg:row-span-2 lg:row-start-4"
    >
      <img
        src={photos.cosplay.src}
        alt={photos.cosplay.alt}
        class="absolute inset-0 size-full object-cover object-[40%_30%]"
        loading="lazy"
        decoding="async"
      />
    </Widget>

    <Widget
      as="section"
      aria-labelledby="latest-writing"
      class="col-span-4 flex flex-col sm:col-span-6 lg:col-span-4 lg:col-start-5 lg:row-span-2 lg:row-start-4"
    >
      <div class="flex items-center justify-between gap-4">
        <h2
          id="latest-writing"
          class="font-display text-title font-extrabold tracking-[-0.02em]"
        >
          Latest writing
        </h2>
        <a
          href="/blog/"
          class="text-muted-foreground hover:text-foreground text-caption inline-flex min-h-8 items-center gap-1 font-bold whitespace-nowrap transition-colors"
        >
          View all posts <Icon name="arrow-right" class="size-3.5" />
        </a>
      </div>
      <ul class="mt-2 flex flex-1 flex-col lg:justify-between">
        {
          latestPosts.map((post) => (
            <li class="border-border border-t first:border-t-0">
              <a
                href={`/posts/${post.id}/`}
                class="hover:text-primary flex items-baseline gap-3 py-1.5 transition-colors"
              >
                <time
                  datetime={new Date(post.data.date).toISOString()}
                  class="text-muted-foreground text-meta w-[4.75rem] shrink-0 font-semibold"
                >
                  {formatDate(post.data.date)}
                </time>
                <span class="text-body line-clamp-2 leading-snug font-semibold lg:truncate">
                  {post.data.title}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </Widget>
  </section>

  <section
    aria-label="Writing, work and contact"
    class="mt-4 grid grid-cols-4 gap-3 md:mt-6 md:gap-4 lg:grid-cols-8"
    id="work"
  >
    <Widget
      as="section"
      aria-labelledby="more-writing"
      class="col-span-4 lg:col-span-5"
    >
      <h2
        id="more-writing"
        class="font-display text-title font-extrabold tracking-[-0.02em]"
      >
        More from the blog
      </h2>
      <ul class="mt-2">
        {
          morePosts.map((post) => (
            <li class="border-border border-t first:border-t-0">
              <a
                href={`/posts/${post.id}/`}
                class="hover:text-primary flex items-baseline gap-3 py-2 transition-colors"
              >
                <time
                  datetime={new Date(post.data.date).toISOString()}
                  class="text-muted-foreground text-meta w-[4.75rem] shrink-0 font-semibold"
                >
                  {formatDate(post.data.date)}
                </time>
                <span class="text-body leading-snug font-semibold">
                  {post.data.title}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </Widget>

    <Widget
      as="section"
      aria-labelledby="work-heading"
      class="col-span-4 flex flex-col lg:col-span-3 lg:row-span-2"
    >
      <h2
        id="work-heading"
        class="font-display text-title font-extrabold tracking-[-0.02em]"
      >
        Work
      </h2>
      <ul class="mt-2 flex flex-1 flex-col justify-between">
        {
          experience.map((job) => (
            <li class="border-border flex items-center gap-3 border-t py-2 first:border-t-0">
              <img
                src={assetUrl(job.logo)}
                alt=""
                width="32"
                height="32"
                loading="lazy"
                class="bg-muted size-8 shrink-0 rounded-[22.5%] object-contain p-1"
              />
              <div class="min-w-0 flex-1">
                <p class="text-body truncate leading-tight font-bold">
                  {job.company}
                </p>
                <p class="text-muted-foreground text-caption truncate">
                  {job.role}
                </p>
              </div>
              <span class="text-muted-foreground text-meta shrink-0 text-right font-semibold">
                {job.startDate}
                <br />
                {job.endDate}
              </span>
            </li>
          ))
        }
      </ul>
      <a
        href="/resume/"
        class="bg-foreground text-background hover:bg-primary hover:text-primary-foreground text-label mt-3 inline-flex min-h-10 items-center justify-center gap-1.5 rounded-full px-4 font-bold transition-colors"
      >
        Resume <Icon name="arrow-right" class="size-3.5" />
      </a>
    </Widget>

    <Widget
      as="section"
      aria-labelledby="speaking-heading"
      tone="ink"
      class="col-span-4 flex flex-col justify-between gap-4 sm:col-span-2 lg:col-span-3"
    >
      <h2
        id="speaking-heading"
        class="font-display text-title font-extrabold tracking-[-0.02em]"
      >
        Speaking
      </h2>
      <p class="text-on-ink-muted text-body">
        I regularly speak at community meetups and conferences about AI,
        JavaScript, React Native, and the web. I've given 25+ talks since 2017
        across events like React Nexus, JSLovers, Thoughtworks Geeknight, React
        Bangalore, and more.
      </p>
      <a
        href="/speaking/"
        class="bg-on-ink text-ink text-label inline-flex min-h-10 items-center justify-center gap-1.5 self-start rounded-full px-4 font-bold transition-opacity hover:opacity-85"
      >
        View all talks <Icon name="arrow-right" class="size-3.5" />
      </a>
    </Widget>

    <Widget
      tone="photo"
      class="col-span-4 aspect-[16/10] sm:col-span-2 sm:aspect-auto lg:col-span-2"
    >
      <img
        src={photos.market.src}
        alt={photos.market.alt}
        class="absolute inset-0 size-full object-cover"
        loading="lazy"
        decoding="async"
      />
    </Widget>

    <Widget
      as="section"
      aria-labelledby="connect-heading"
      class="col-span-4 lg:col-span-8"
    >
      <h2
        id="connect-heading"
        class="font-display text-title font-extrabold tracking-[-0.02em]"
      >
        Connect
      </h2>
      <ul class="mt-3 grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
        {
          connectLinks.map((link) => (
            <li>
              <a
                href={link.href}
                target={isExternal(link.href) ? "_blank" : undefined}
                rel={isExternal(link.href) ? "noopener" : undefined}
                class="bg-muted hover:bg-foreground hover:text-background flex min-h-12 items-center gap-3 rounded-2xl px-3.5 py-2 transition-colors"
              >
                <Icon name={link.icon} class="size-4" />
                <span class="min-w-0">
                  <span class="text-meta block font-semibold opacity-70">
                    {link.platform}
                  </span>
                  <span class="text-label block truncate font-bold">
                    {link.handle}
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </Widget>

    <Newsletter
      heading="Stay in the loop"
      description="Thoughts delivered straight to your inbox. Zero spam, I promise."
      buttonLabel="Subscribe"
      class="col-span-4 lg:col-span-8"
    />
  </section>
</MainLayout>

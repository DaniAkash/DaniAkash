---
import { getCollection, render } from "astro:content";
import { Schema } from "astro-seo-schema";
import Globe from "../components/Globe.tsx";
import Icon, { type IconName } from "../components/Icon.astro";
import Tile from "../components/Tile.astro";
import { ASSET_PREFIX, assetUrl } from "../constants/asset-prefix";
import { PERSON_ENTITY_ID } from "../constants/seo";
import MainLayout from "../layouts/MainLayout.astro";

const siteUrl = Astro.site?.href || "https://daniakash.com/";
const about = (await getCollection("about"))[0]!;
const { Content } = await render(about);
const social = (await getCollection("social"))[0]!;
const destinationsData = (await getCollection("destinations"))[0]!;
const destinations = destinationsData.data.items;

const connectLinks: { label: string; href: string; icon: IconName }[] = [
  { label: "Follow on Bluesky", href: social.data.bluesky, icon: "bluesky" },
  { label: "Follow on X", href: social.data.twitter, icon: "x" },
  {
    label: "Follow on Instagram",
    href: social.data.instagram,
    icon: "instagram",
  },
  { label: "Follow on GitHub", href: social.data.github, icon: "github" },
  { label: "Follow on LinkedIn", href: social.data.linkedIn, icon: "linkedin" },
  {
    label: social.data.email,
    href: `mailto:${social.data.email}`,
    icon: "mail",
  },
];
---

<MainLayout title="About" description="Dani Akash | AI Engineer, builder, and speaker based in Chennai, India. Building AI agents and writing about JavaScript, React Native, and the web.">
  <Schema
    item={{
      "@context": "https://schema.org",
      "@type": "Person",
      "@id": PERSON_ENTITY_ID,
      name: "Dani Akash",
      url: new URL("/about/", siteUrl).href,
      image: `${ASSET_PREFIX}/avatar.jpg`,
      jobTitle: "AI Engineer",
      description:
        "AI Engineer, speaker, and open source contributor based in Chennai, India. Building AI agents and writing about JavaScript, React Native, and the web.",
      nationality: {
        "@type": "Country",
        name: "India",
      },
      address: {
        "@type": "PostalAddress",
        addressLocality: "Chennai",
        addressCountry: "IN",
      },
      sameAs: [
        social.data.github,
        social.data.twitter,
        social.data.bluesky,
        social.data.linkedIn,
        social.data.instagram,
        "https://www.google.com/search?kgmid=/g/11gbhlgy7j",
      ],
      knowsAbout: [
        "Artificial Intelligence",
        "AI Agents",
        "JavaScript",
        "TypeScript",
        "React Native",
        "React",
        "Web Development",
        "Open Source",
      ],
    }}
  />

  <div class="grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-5 lg:grid-cols-6">
    <Tile
      as="header"
      class="col-span-2 flex min-h-[7.5rem] flex-col justify-end gap-2.5 md:col-span-4 md:min-h-[11rem] lg:col-span-3 lg:min-h-[13rem]"
    >
      <h1 class="font-display text-subdisplay md:text-display leading-[0.95] font-extrabold tracking-[-0.03em]">
        I’m Dani Akash
      </h1>
      <p class="text-muted-foreground flex flex-wrap items-center gap-x-3 gap-y-1 text-lede">
        <span class="text-foreground font-semibold">AI Engineer · Builder · Speaker</span>
        <span class="inline-flex items-center gap-1">
          <Icon name="map-pin" class="size-3.5" /> Chennai, India
        </span>
      </p>
    </Tile>

    <Tile tone="photo" class="col-span-2 aspect-[4/3] md:aspect-auto lg:col-span-2">
      <img
        src={assetUrl("image-2.jpg")}
        alt="Dani Akash coding at his desk with a cat on his lap"
        class="absolute inset-0 size-full object-cover object-[30%_25%]"
        loading="eager"
        decoding="async"
      />
    </Tile>

    <Tile tone="photo" class="col-span-2 aspect-[4/3] md:col-span-2 md:aspect-auto lg:col-span-1">
      <img
        src={assetUrl("image-4.jpg")}
        alt="Dani Akash overlooking a river gorge on a hike"
        class="absolute inset-0 size-full object-cover object-[70%_50%]"
        loading="eager"
        decoding="async"
      />
    </Tile>

    <div class="col-span-2 flex flex-col gap-3 md:col-span-4 md:gap-5 lg:col-span-3">
      <Tile as="article" class="md:p-7">
        <div class="prose max-w-[68ch]">
          <Content />
        </div>
      </Tile>

      <Tile as="section" aria-labelledby="about-connect" class="md:p-6">
        <h2
          id="about-connect"
          class="font-display text-title font-bold tracking-[-0.02em]"
        >
          SYSTEM.CONNECT // UPLINKS
        </h2>
        <ul class="mt-3 grid gap-2 sm:grid-cols-2">
          {
            connectLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  target={link.href.startsWith("mailto") ? undefined : "_blank"}
                  rel="noopener"
                  class="bg-muted hover:bg-foreground hover:text-background flex min-h-10 items-center gap-2.5 rounded-xl px-3 py-2 text-body font-semibold transition-colors"
                >
                  <Icon name={link.icon} class="size-4" />
                  <span class="min-w-0 truncate">{link.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </Tile>
    </div>

    <Tile
      as="aside"
      tone="ink"
      aria-labelledby="about-destinations"
      class="col-span-2 flex h-[28rem] flex-col gap-2 md:col-span-4 md:h-[34rem] lg:sticky lg:top-6 lg:col-span-3 lg:h-[calc(100vh-3rem)] lg:max-h-[40rem] lg:self-start"
    >
      <div class="flex items-baseline justify-between gap-4">
        <h2
          id="about-destinations"
          class="font-display text-title font-bold tracking-[-0.02em]"
        >
          Destinations
        </h2>
        <span class="text-on-ink-muted font-mono text-meta">{destinations.length} places</span>
      </div>
      <div class="min-h-0 flex-1">
        <Globe client:only="react" destinations={destinations} />
      </div>
    </Tile>
  </div>
</MainLayout>

---
import MarkdownIt from "markdown-it";
import AppSheet from "../components/AppSheet.astro";
import Widget from "../components/Widget.astro";
import rawMd from "../content/now/now.md?raw";
import MainLayout from "../layouts/MainLayout.astro";

const md = new MarkdownIt({ html: false, linkify: false });
const defaultLinkOpen =
  md.renderer.rules.link_open ??
  ((tokens, idx, options, _env, self) =>
    self.renderToken(tokens, idx, options));
md.renderer.rules.link_open = (tokens, idx, options, env, self) => {
  const href = tokens[idx]?.attrGet("href") ?? "";
  if (href.startsWith("http") && !href.startsWith("https://daniakash.com")) {
    tokens[idx]?.attrSet("target", "_blank");
    tokens[idx]?.attrSet("rel", "noopener");
  }
  return defaultLinkOpen(tokens, idx, options, env, self);
};

const content = rawMd.replace(/^---[\s\S]*?---\n*/, "").trim();
const [intro = "", ...sections] = content.split(/^## /m);

const entries = sections.map((section) => {
  const newline = section.indexOf("\n");
  const date = section.slice(0, newline).trim();
  return { date, html: md.render(section.slice(newline + 1).trim()) };
});
const [latest, ...older] = entries;
const introHtml = md.renderInline(intro.replace(/^>\s*/, "").trim());
---

<MainLayout title="Now" description="What Dani Akash is working on right now | current projects, talks, and interests.">
  <AppSheet title="Now">
    <p
      slot="header"
      class="text-muted-foreground text-body [&_a]:text-foreground mt-2 [&_a]:font-semibold [&_a]:underline [&_a]:decoration-2 [&_a]:underline-offset-4"
      set:html={introHtml}
    />

    {
      latest && (
        <Widget tone="blue" as="section" aria-labelledby="now-latest" class="md:p-7">
          <h2
            id="now-latest"
            class="font-display text-heading font-extrabold tracking-[-0.025em]"
          >
            <time>{latest.date}</time>
          </h2>
          <div
            class="text-lede mt-3 max-w-[68ch] [&_a]:font-semibold [&_a]:underline [&_a]:decoration-white/50 [&_a]:decoration-2 [&_a]:underline-offset-4 hover:[&_a]:decoration-white [&_li]:mt-1.5 [&_li_ul]:mt-1 [&_ul]:list-disc [&_ul]:pl-5 [&_ul]:marker:text-white/70"
            set:html={latest.html}
          />
        </Widget>
      )
    }

    <ol class="mt-8 flex flex-col">
      {
        older.map((entry) => (
          <li class="border-border grid gap-1 border-t py-6 first:border-t-0 first:pt-0 md:grid-cols-[11rem_minmax(0,1fr)] md:gap-8">
            <h2 class="font-display text-title font-extrabold tracking-[-0.02em] md:sticky md:top-6 md:self-start">
              <time>{entry.date}</time>
            </h2>
            <div
              class="prose dark:prose-invert text-body max-w-[68ch] [&_li]:my-1 [&_ul]:my-0"
              set:html={entry.html}
            />
          </li>
        ))
      }
    </ol>
  </AppSheet>
</MainLayout>

---
import { getCollection } from "astro:content";
import AppSheet from "../components/AppSheet.astro";
import Icon from "../components/Icon.astro";
import { assetUrl } from "../constants/asset-prefix";
import MainLayout from "../layouts/MainLayout.astro";

const sections = (await getCollection("uses"))[0]?.data.items ?? [];

/** Resolve an image path: absolute URLs pass through, relative paths get the asset prefix */
const resolveImage = (path?: string) => {
  if (!path) return undefined;
  if (path.startsWith("http://") || path.startsWith("https://")) return path;
  return assetUrl(path);
};

const slug = (title: string) =>
  title
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)/g, "");
---

<MainLayout title="Uses" description="Hardware, software, and tools Dani Akash uses for development.">
  <AppSheet
    title="Tools of the Trade"
    lede="A peek behind the curtain — the stuff that keeps me running (and coding)."
  >
    <nav aria-label="Sections" class="flex flex-wrap gap-2">
      {
        sections.map((section) => (
          <a
            href={`#${slug(section.title)}`}
            class="bg-muted hover:bg-foreground hover:text-background text-label inline-flex min-h-9 items-center gap-2 rounded-full px-3.5 font-bold transition-colors"
          >
            {section.title}
            <span class="text-meta tabular opacity-60">{section.tools.length}</span>
          </a>
        ))
      }
    </nav>

    <div class="mt-10 flex flex-col gap-12 md:mt-12 md:gap-14">
      {
        sections.map((section) => {
          const isHardware = section.variant === "hardware";
          const id = slug(section.title);
          return (
            <section id={id} aria-labelledby={`${id}-heading`} class="scroll-mt-6">
              <div class="border-border flex items-baseline justify-between gap-4 border-b pb-3">
                <h2
                  id={`${id}-heading`}
                  class="font-display text-heading font-extrabold tracking-[-0.025em]"
                >
                  {section.title}
                </h2>
                <p class="text-muted-foreground text-label font-semibold">
                  {section.tools.length} {section.tools.length === 1 ? "tool" : "tools"}
                </p>
              </div>

              {isHardware ? (
                <ul class="mt-5 grid grid-flow-row-dense grid-cols-2 gap-3 md:gap-4 lg:grid-cols-4">
                  {section.tools.map((tool) => {
                    const size = tool.size ?? "square";
                    const img = resolveImage(tool.image);
                    return (
                      <li
                        class:list={[
                          "bg-muted flex flex-col overflow-hidden rounded-2xl",
                          size === "wide" && "col-span-2 lg:row-span-2",
                          size === "square" && "col-span-2 sm:col-span-1 lg:row-span-2",
                          size === "small" && "col-span-1",
                        ]}
                      >
                        {img && (
                          <img
                            src={img}
                            alt={tool.title}
                            loading="lazy"
                            class:list={[
                              "w-full object-cover",
                              size === "wide" && "aspect-[16/10] lg:aspect-auto lg:min-h-0 lg:flex-1",
                              size === "square" && "aspect-[4/3] lg:aspect-auto lg:min-h-0 lg:flex-1",
                              size === "small" && "aspect-square",
                            ]}
                          />
                        )}
                        <div class:list={["flex flex-col", size === "small" ? "p-3" : "p-4 md:p-5"]}>
                          <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                            <h3
                              class:list={[
                                "font-display font-extrabold tracking-[-0.02em]",
                                size === "small" ? "text-body" : "text-title",
                              ]}
                            >
                              {tool.title}
                            </h3>
                            {tool.tag && (
                              <span class="bg-card text-muted-foreground text-meta rounded-full px-2 py-0.5 font-bold">
                                {tool.tag}
                              </span>
                            )}
                          </div>
                          <p
                            class:list={[
                              "text-muted-foreground mt-1",
                              size === "small" ? "text-caption line-clamp-3" : "text-body",
                            ]}
                          >
                            {tool.description}
                          </p>
                        </div>
                      </li>
                    );
                  })}
                </ul>
              ) : (
                <ul class="mt-4 grid gap-x-6 gap-y-1 md:grid-cols-2">
                  {section.tools.map((tool) => {
                    const img = resolveImage(tool.image);
                    const Tag = tool.link ? "a" : "div";
                    const linkProps = tool.link
                      ? { href: tool.link, target: "_blank", rel: "noopener" }
                      : {};
                    return (
                      <li>
                        <Tag
                          {...linkProps}
                          class="group hover:bg-muted -mx-2 flex items-start gap-4 rounded-2xl p-2 transition-colors"
                        >
                          <span class="bg-card ring-border flex size-12 shrink-0 items-center justify-center overflow-hidden rounded-[22.5%] ring-1">
                            {img ? (
                              <img
                                src={img}
                                alt=""
                                loading="lazy"
                                class="size-full object-contain"
                              />
                            ) : (
                              <Icon name="laptop" class="text-muted-foreground size-5" />
                            )}
                          </span>
                          <div class="min-w-0 flex-1 pt-0.5">
                            <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                              <h3 class="text-body font-bold">{tool.title}</h3>
                              {tool.tag && (
                                <span class="bg-muted text-muted-foreground text-meta rounded-full px-2 py-0.5 font-bold group-hover:bg-card">
                                  {tool.tag}
                                </span>
                              )}
                              {tool.link && (
                                <Icon
                                  name="arrow-up-right"
                                  class="text-muted-foreground size-3.5 transition-transform duration-300 ease-out-expo group-hover:translate-x-0.5"
                                />
                              )}
                            </div>
                            <p class="text-muted-foreground text-label mt-0.5">
                              {tool.description}
                            </p>
                          </div>
                        </Tag>
                      </li>
                    );
                  })}
                </ul>
              )}
            </section>
          );
        })
      }
    </div>
  </AppSheet>
</MainLayout>

---
import { getCollection } from "astro:content";
import Icon from "../components/Icon.astro";
import Tile from "../components/Tile.astro";
import { assetUrl } from "../constants/asset-prefix";
import MainLayout from "../layouts/MainLayout.astro";

const uses = (await getCollection("uses"))[0]!;
const sections = uses.data.items;

const toolCount = sections.reduce(
  (total, section) => total + section.tools.length,
  0,
);
const agentCount =
  sections.find((section) => section.title === "Coding Agents")?.tools.length ??
  0;

/** Resolve an image path: absolute URLs pass through, relative paths get the asset prefix */
const resolveImage = (path?: string) => {
  if (!path) return undefined;
  if (path.startsWith("http://") || path.startsWith("https://")) return path;
  return assetUrl(path);
};

const hardwareSpan = {
  wide: "col-span-2 md:col-span-4",
  square: "col-span-2 md:col-span-2",
  small: "col-span-1 md:col-span-1",
} as const;
---

<MainLayout title="Uses" description="Hardware, software, and tools Dani Akash uses for development.">
  <section
    aria-label="Uses introduction"
    class="grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-4 lg:grid-cols-6"
  >
    <Tile
      as="header"
      class="col-span-2 flex flex-col justify-end gap-4 md:col-span-4 md:min-h-[18rem] lg:col-span-4"
    >
      <h1 class="font-display text-[clamp(2.5rem,5vw,4.5rem)] leading-[0.95] font-extrabold tracking-[-0.035em]">
        Tools of the Trade
      </h1>
      <p class="text-muted-foreground max-w-[44ch] text-lg leading-snug md:text-xl">
        A peek behind the curtain — the stuff that keeps me running (and coding).
      </p>
    </Tile>
    <Tile tone="yellow" class="flex min-h-[10rem] flex-col justify-end md:col-span-2 lg:col-span-1">
      <p class="font-display tabular text-6xl leading-none font-extrabold tracking-[-0.03em]">
        {toolCount}
      </p>
      <p class="mt-2 text-sm font-semibold">Tools on this page</p>
    </Tile>
    <Tile tone="ink" class="flex min-h-[10rem] flex-col justify-end md:col-span-2 lg:col-span-1">
      <p class="font-display tabular text-6xl leading-none font-extrabold tracking-[-0.03em]">
        {agentCount}
      </p>
      <p class="text-on-ink-muted mt-2 text-sm font-semibold">Coding agents</p>
    </Tile>
  </section>

  {
    sections.map((section) => {
      const isHardware = section.variant === "hardware";
      const headingId = `uses-${section.title.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`;

      return (
        <section aria-labelledby={headingId} class="mt-10 md:mt-14">
          <h2
            id={headingId}
            class="font-display mb-4 px-1 text-3xl leading-none font-bold tracking-[-0.025em] md:mb-5 md:text-4xl"
          >
            {section.title}
          </h2>

          {isHardware ? (
            <div class="grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-4">
              {section.tools.map((tool) => {
                const size = tool.size ?? "square";
                const img = resolveImage(tool.image);
                return (
                  <Tile
                    as="article"
                    class:list={[
                      hardwareSpan[size],
                      "flex flex-col p-0 md:p-0",
                      size === "wide" && "md:flex-row",
                    ]}
                  >
                    <div
                      class:list={[
                        "bg-muted relative overflow-hidden",
                        size === "wide" &&
                          "aspect-[16/10] md:aspect-auto md:min-h-[20rem] md:w-[55%]",
                        size === "square" && "aspect-[4/3]",
                        size === "small" && "aspect-square",
                      ]}
                    >
                      {img && (
                        <img
                          src={img}
                          alt={tool.title}
                          loading="lazy"
                          decoding="async"
                          class="absolute inset-0 size-full object-cover"
                        />
                      )}
                    </div>
                    <div
                      class:list={[
                        "flex flex-1 flex-col gap-2",
                        size === "small" ? "p-4" : "p-5 md:p-6",
                        size === "wide" && "md:justify-center md:p-8",
                      ]}
                    >
                      <h3
                        class:list={[
                          "font-display leading-tight font-bold tracking-[-0.015em]",
                          size === "wide" && "text-2xl md:text-3xl",
                          size === "square" && "text-xl md:text-2xl",
                          size === "small" && "text-base md:text-lg",
                        ]}
                      >
                        {tool.title}
                      </h3>
                      {tool.tag && (
                        <span class="bg-yellow text-on-yellow self-start rounded-full px-2.5 py-0.5 text-xs font-semibold">
                          {tool.tag}
                        </span>
                      )}
                      <p
                        class:list={[
                          "text-muted-foreground leading-relaxed",
                          size === "small" ? "text-[13px]" : "text-[15px]",
                        ]}
                      >
                        {tool.description}
                      </p>
                    </div>
                  </Tile>
                );
              })}
            </div>
          ) : (
            <div class="grid gap-3 sm:grid-cols-2 md:gap-4 lg:grid-cols-3">
              {section.tools.map((tool) => {
                const img = resolveImage(tool.image);
                return (
                  <Tile
                    {...(tool.link
                      ? { href: tool.link, target: "_blank", rel: "noopener" }
                      : {})}
                    class="flex gap-4"
                  >
                    <div class="bg-muted flex size-14 shrink-0 items-center justify-center overflow-hidden rounded-2xl">
                      {img && (
                        <img
                          src={img}
                          alt=""
                          loading="lazy"
                          decoding="async"
                          class="size-full object-contain"
                        />
                      )}
                    </div>
                    <div class="flex min-w-0 flex-1 flex-col gap-1.5">
                      <div class="flex items-start justify-between gap-2">
                        <h3 class="text-lg leading-snug font-semibold">
                          {tool.title}
                        </h3>
                        {tool.link && (
                          <Icon
                            name="arrow-up-right"
                            class="text-muted-foreground group-hover:text-foreground mt-1 size-4 transition-[color,transform] duration-300 ease-out-expo group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                          />
                        )}
                      </div>
                      {tool.tag && (
                        <span class="bg-muted self-start rounded-full px-2.5 py-0.5 text-xs font-semibold">
                          {tool.tag}
                        </span>
                      )}
                      <p class="text-muted-foreground text-sm leading-relaxed">
                        {tool.description}
                      </p>
                    </div>
                  </Tile>
                );
              })}
            </div>
          )}
        </section>
      );
    })
  }
</MainLayout>

---
import { getCollection } from "astro:content";
import Icon from "../components/Icon.astro";
import Tile from "../components/Tile.astro";
import MainLayout from "../layouts/MainLayout.astro";

const posts = (await getCollection("blog")).sort((a, b) => {
  return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
});

const postsByYear = new Map<number, typeof posts>();
for (const post of posts) {
  const year = new Date(post.data.date).getFullYear();
  if (!postsByYear.has(year)) postsByYear.set(year, []);
  postsByYear.get(year)?.push(post);
}
const years = [...postsByYear.keys()].sort((a, b) => b - a);
const firstYear = years[years.length - 1];
---

<MainLayout title="Blog" description="Articles on AI, JavaScript, React Native, and building for the web.">
  <header class="grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-5 lg:grid-cols-6">
    <Tile
      as="div"
      class="col-span-2 flex min-h-[8.625rem] flex-col justify-end md:col-span-4 lg:col-span-4"
    >
      <h1 class="font-display text-subdisplay md:text-display leading-[0.95] font-extrabold tracking-[-0.03em]">
        The Blog Zone
      </h1>
      <p class="text-muted-foreground mt-2 max-w-[48ch] text-lede leading-snug">
        Where my thoughts get some air time and occasionally make sense.
      </p>
    </Tile>
    <Tile tone="yellow" class="flex min-h-[8.625rem] flex-col justify-between">
      <p class="text-caption font-semibold">Since {firstYear}</p>
      <p>
        <span class="font-display tabular block text-stat leading-none font-extrabold tracking-[-0.03em]">
          {posts.length}
        </span>
        <span class="mt-1 block text-caption font-semibold">posts written</span>
      </p>
    </Tile>
    <Tile
      href="/rss.xml"
      tone="ink"
      class="flex min-h-[8.625rem] flex-col justify-between"
    >
      <Icon name="rss" class="size-5" />
      <p class="inline-flex items-center gap-1 text-body leading-tight font-semibold">
        Follow via RSS
        <Icon
          name="arrow-right"
          class="size-4 transition-transform duration-300 ease-out-expo group-hover:translate-x-1"
        />
      </p>
    </Tile>
  </header>

  <div class="mt-3 flex flex-col gap-3 md:mt-5 md:gap-5">
    {
      years.map((year) => {
        const yearPosts = postsByYear.get(year)!;
        return (
          <Tile
            as="section"
            aria-labelledby={`year-${year}`}
            class="grid gap-1 lg:grid-cols-[9rem_1fr] lg:gap-6"
          >
            <h2
              id={`year-${year}`}
              class="font-display tabular text-subdisplay leading-none font-extrabold tracking-[-0.03em] lg:sticky lg:top-6 lg:self-start lg:pt-2.5"
            >
              {year}
            </h2>
            <ul>
              {yearPosts.map((post) => {
                const date = new Date(post.data.date);
                const dateDisplay = date.toLocaleDateString("en-US", {
                  month: "long",
                  day: "numeric",
                  year: "numeric",
                });
                return (
                  <li class="border-border border-t first:border-t-0">
                    <a
                      href={`/posts/${post.id}/`}
                      class="group/post hover:bg-tile-hover -mx-2.5 grid gap-0.5 rounded-xl px-2.5 py-3 transition-colors md:grid-cols-[1fr_auto] md:gap-x-6"
                    >
                      <time
                        datetime={date.toISOString()}
                        class="text-muted-foreground font-mono text-meta md:col-start-2 md:row-start-1 md:pt-1"
                      >
                        {dateDisplay}
                      </time>
                      <span class="group-hover/post:text-primary text-lede leading-snug font-semibold tracking-[-0.01em] transition-colors md:col-start-1 md:row-start-1">
                        {post.data.title}
                      </span>
                      <span class="text-muted-foreground line-clamp-2 max-w-[70ch] text-body leading-normal md:col-start-1">
                        {post.data.subtitle}
                      </span>
                      <span class="text-primary mt-1 inline-flex items-center gap-1 text-caption font-semibold md:col-start-1">
                        Read article
                        <Icon
                          name="arrow-right"
                          class="size-3.5 transition-transform duration-300 ease-out-expo group-hover/post:translate-x-1"
                        />
                      </span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </Tile>
        );
      })
    }
  </div>
</MainLayout>

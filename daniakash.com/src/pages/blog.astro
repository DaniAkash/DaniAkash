---
import { getCollection } from "astro:content";
import AppSheet from "../components/AppSheet.astro";
import Icon from "../components/Icon.astro";
import MainLayout from "../layouts/MainLayout.astro";

const posts = (await getCollection("blog")).sort((a, b) => {
  return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
});

// Group posts by year
const postsByYear = new Map<number, typeof posts>();
for (const post of posts) {
  const year = new Date(post.data.date).getFullYear();
  if (!postsByYear.has(year)) postsByYear.set(year, []);
  postsByYear.get(year)?.push(post);
}
const years = [...postsByYear.keys()].sort((a, b) => b - a);

const formatDate = (value: string) =>
  new Date(value).toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
  });
---

<MainLayout
  title="Blog"
  description="Articles on AI, JavaScript, React Native, and building for the web."
>
  <AppSheet
    title="The Blog Zone"
    lede="Where my thoughts get some air time and occasionally make sense."
  >
    <a
      slot="header"
      href="/rss.xml"
      class="bg-muted hover:bg-foreground hover:text-background text-label mt-4 inline-flex min-h-9 items-center gap-1.5 rounded-full px-3.5 font-bold transition-colors"
    >
      <Icon name="rss" class="size-4" />
      Follow via RSS
    </a>

    <div class="flex flex-col gap-8 md:gap-10">
      {
        years.map((year) => {
          const yearPosts = postsByYear.get(year) ?? [];
          return (
            <section
              aria-labelledby={`year-${year}`}
              class="grid gap-3 md:grid-cols-[8rem_1fr] md:gap-6"
            >
              <div class="md:pt-3.5">
                <h2
                  id={`year-${year}`}
                  class="font-display text-title tabular font-extrabold tracking-[-0.02em] md:sticky md:top-6"
                >
                  {year}
                  <span class="text-muted-foreground text-caption ml-2 font-sans font-semibold md:mt-1 md:ml-0 md:block">
                    {yearPosts.length} {yearPosts.length === 1 ? "post" : "posts"}
                  </span>
                </h2>
              </div>
              <ul class="flex flex-col">
                {yearPosts.map((post) => (
                  <li class="border-border border-t first:border-t-0">
                    <a
                      href={`/posts/${post.id}/`}
                      class="group hover:bg-muted -mx-3 grid gap-1 rounded-2xl px-3 py-3.5 transition-colors sm:grid-cols-[1fr_auto] sm:gap-6"
                    >
                      <span class="min-w-0">
                        <span class="text-lede group-hover:text-primary block leading-snug font-bold transition-colors">
                          {post.data.title}
                        </span>
                        <span class="text-muted-foreground text-caption mt-1 line-clamp-2 block">
                          {post.data.subtitle}
                        </span>
                      </span>
                      <time
                        datetime={new Date(post.data.date).toISOString()}
                        class="text-muted-foreground text-meta tabular order-first font-semibold sm:order-none sm:pt-1.5 sm:text-right"
                      >
                        {formatDate(post.data.date)}
                      </time>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          );
        })
      }
    </div>
  </AppSheet>
</MainLayout>

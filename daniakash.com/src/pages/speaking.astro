---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { Schema } from "astro-seo-schema";
import AppSheet from "../components/AppSheet.astro";
import Icon from "../components/Icon.astro";
import { ASSET_PREFIX } from "../constants/asset-prefix";
import { PERSON_ENTITY_ID } from "../constants/seo";
import MainLayout from "../layouts/MainLayout.astro";
import { getYoutubeThumbnail } from "../utils/getYoutubeThumbnail";

const events = (await getCollection("speaking")).sort(
  (a, b) => b.data.year - a.data.year,
);

const talkCount = events.reduce(
  (total, group) => total + group.data.events.length,
  0,
);
---

<MainLayout title="Speaking" description="25+ talks on AI, JavaScript, React Native, and the web at conferences and community meetups since 2017.">
  <Schema
    item={{
      "@context": "https://schema.org",
      "@type": "ItemList",
      name: "Speaking Engagements by Dani Akash",
      itemListElement: events.flatMap((yearGroup) =>
        yearGroup.data.events.map((event) => ({
          "@type": "Event" as const,
          name: event.title,
          description: event.description,
          startDate: new Date(event.date).toISOString().split("T")[0] as string,
          location: event.name,
          performer: {
            "@type": "Person" as const,
            "@id": PERSON_ENTITY_ID,
            name: "Dani Akash",
          },
          eventAttendanceMode:
            "https://schema.org/OfflineEventAttendanceMode",
          ...(event.video && {
            url: event.video,
          }),
        })),
      ),
    }}
  />

  <AppSheet
    title="Words I've Said"
    lede="You can actually hear me talk, not just type."
  >
    <nav aria-label="Years" class="flex flex-wrap gap-2">
      {
        events.map((yearGroup) => (
          <a
            href={`#year-${yearGroup.data.year}`}
            class="bg-muted hover:bg-foreground hover:text-background text-label inline-flex min-h-9 items-center gap-2 rounded-full px-3.5 font-bold transition-colors"
          >
            {yearGroup.data.year}
            <span class="text-meta tabular opacity-60">
              {yearGroup.data.events.length}
            </span>
          </a>
        ))
      }
      <span class="text-muted-foreground text-label inline-flex min-h-9 items-center px-1 font-semibold">
        {talkCount} talks in all
      </span>
    </nav>

    <div class="mt-10 flex flex-col gap-12 md:mt-12 md:gap-14">
      {
        events.map((yearGroup) => (
          <section
            id={`year-${yearGroup.data.year}`}
            aria-labelledby={`year-${yearGroup.data.year}-heading`}
            class="scroll-mt-6"
          >
            <div class="border-border flex items-baseline justify-between gap-4 border-b pb-3">
              <h2
                id={`year-${yearGroup.data.year}-heading`}
                class="font-display text-heading tabular font-extrabold tracking-[-0.025em]"
              >
                {yearGroup.data.year}
              </h2>
              <p class="text-muted-foreground text-label font-semibold">
                {yearGroup.data.events.length}{" "}
                {yearGroup.data.events.length === 1 ? "talk" : "talks"}
              </p>
            </div>

            <ul class="mt-5 grid gap-x-5 gap-y-6 sm:grid-cols-2 sm:gap-y-8 lg:grid-cols-3">
              {yearGroup.data.events.map((event) => {
                const youtubeThumbnail = getYoutubeThumbnail(event.video ?? "");
                const primaryLink = event.video ?? event.cta?.[0]?.url;
                const hasThumbnail = !!(
                  event.thumbnail ||
                  (event.video && youtubeThumbnail)
                );

                return (
                  <li class="group relative grid grid-cols-[7.5rem_1fr] items-start gap-3 sm:flex sm:flex-col sm:gap-0">
                    {primaryLink && (
                      <a
                        href={primaryLink}
                        target="_blank"
                        rel="noopener"
                        class="absolute inset-0 z-0 rounded-xl"
                        aria-label={event.title}
                      />
                    )}
                    <div class="pointer-events-none relative z-1 aspect-video overflow-hidden rounded-xl">
                      {hasThumbnail ? (
                        event.thumbnail ? (
                          <Image
                            height={360}
                            width={640}
                            alt={event.title}
                            src={ASSET_PREFIX + event.thumbnail}
                            class="bg-muted size-full object-cover transition-transform duration-500 ease-out-expo group-hover:scale-[1.03]"
                          />
                        ) : (
                          <img
                            src={youtubeThumbnail!}
                            alt={event.title}
                            class="bg-muted size-full object-cover transition-transform duration-500 ease-out-expo group-hover:scale-[1.03]"
                            loading="lazy"
                          />
                        )
                      ) : (
                        <div class="flex size-full items-end bg-[#E5357F] p-2.5 text-white sm:p-4">
                          <p class="font-display text-label sm:text-title font-extrabold tracking-[-0.02em]">
                            {event.name}
                          </p>
                        </div>
                      )}
                      {event.video && (
                        <span class="bg-card text-card-foreground absolute bottom-1.5 left-1.5 inline-flex size-6 items-center justify-center rounded-full sm:bottom-2.5 sm:left-2.5 sm:size-8">
                          <Icon name="play" class="ml-0.5 size-3 sm:size-3.5" />
                        </span>
                      )}
                    </div>
                    <div class="pointer-events-none relative z-1 flex min-w-0 flex-1 flex-col sm:mt-3">
                      <p class="text-caption line-clamp-1 font-bold">{event.name}</p>
                      <time
                        class="text-muted-foreground text-caption tabular mt-0.5 block font-semibold whitespace-nowrap"
                        datetime={new Date(event.date).toISOString().split("T")[0]}
                      >
                        {event.date}
                      </time>
                      <h3 class="font-display text-label sm:text-body group-hover:text-primary mt-1 leading-snug font-extrabold tracking-[-0.01em] transition-colors sm:mt-1.5">
                        {event.title}
                      </h3>
                      <p class="text-muted-foreground text-caption mt-1 line-clamp-2 sm:line-clamp-3">
                        {event.description}
                      </p>
                      {event.cta && event.cta.length > 0 && (
                        <div class="mt-2.5 flex flex-wrap gap-1">
                          {event.cta.map((cta) => (
                            <a
                              href={cta.url}
                              target="_blank"
                              rel="noopener"
                              class="bg-muted hover:bg-foreground hover:text-background text-caption pointer-events-auto relative z-2 inline-flex min-h-8 items-center gap-1 rounded-full px-2.5 font-bold transition-colors"
                            >
                              {cta.title}
                              <Icon name="arrow-up-right" class="size-3" />
                            </a>
                          ))}
                        </div>
                      )}
                    </div>
                  </li>
                );
              })}
            </ul>
          </section>
        ))
      }
    </div>
  </AppSheet>
</MainLayout>

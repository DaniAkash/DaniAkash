---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { Schema } from "astro-seo-schema";
import Icon from "../components/Icon.astro";
import Tile from "../components/Tile.astro";
import { ASSET_PREFIX, assetUrl } from "../constants/asset-prefix";
import { PERSON_ENTITY_ID } from "../constants/seo";
import MainLayout from "../layouts/MainLayout.astro";
import { getYoutubeThumbnail } from "../utils/getYoutubeThumbnail";

const events = (await getCollection("speaking")).sort(
  (a, b) => b.data.year - a.data.year,
);

const talkCount = events.reduce(
  (total, group) => total + group.data.events.length,
  0,
);
const firstYear = Math.min(...events.map((group) => group.data.year));
---

<MainLayout title="Speaking" description="25+ talks on AI, JavaScript, React Native, and the web at conferences and community meetups since 2017.">
  <Schema
    item={{
      "@context": "https://schema.org",
      "@type": "ItemList",
      name: "Speaking Engagements by Dani Akash",
      itemListElement: events.flatMap((yearGroup) =>
        yearGroup.data.events.map((event) => ({
          "@type": "Event" as const,
          name: event.title,
          description: event.description,
          startDate: new Date(event.date).toISOString().split("T")[0] as string,
          location: event.name,
          performer: {
            "@type": "Person" as const,
            "@id": PERSON_ENTITY_ID,
            name: "Dani Akash",
          },
          eventAttendanceMode:
            "https://schema.org/OfflineEventAttendanceMode",
          ...(event.video && {
            url: event.video,
          }),
        })),
      ),
    }}
  />

  <section
    aria-label="Speaking introduction"
    class="grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-5 lg:grid-cols-6"
  >
    <Tile
      as="header"
      class="col-span-2 flex flex-col justify-end gap-2 md:col-span-4 md:min-h-[13rem] lg:col-span-3"
    >
      <h1 class="font-display text-subdisplay md:text-display leading-[1] font-extrabold tracking-[-0.03em]">
        Words I've Said
      </h1>
      <p class="text-muted-foreground text-lede max-w-[44ch] leading-snug">
        You can actually hear me talk, not just type.
      </p>
    </Tile>
    <Tile tone="pink" class="flex min-h-[8.5rem] flex-col justify-between md:col-span-1 lg:col-span-1">
      <p class="text-caption font-semibold">Talks since {firstYear}</p>
      <p class="font-display tabular text-stat leading-none font-extrabold tracking-[-0.03em]">
        {talkCount}
      </p>
    </Tile>
    <Tile tone="photo" class="aspect-square md:col-span-3 md:aspect-auto lg:col-span-2">
      <img
        src={assetUrl("image-3.jpg")}
        alt="Dani Akash speaking at a tech meetup with a microphone"
        class="absolute inset-0 size-full object-cover object-[60%_40%]"
        loading="eager"
        decoding="async"
      />
    </Tile>
  </section>

  {
    events.map((yearGroup) => {
      const talks = yearGroup.data.events;
      return (
        <section
          aria-labelledby={`year-${yearGroup.data.year}`}
          class="mt-6 grid gap-3 md:mt-8 md:gap-5 lg:grid-cols-[minmax(0,1fr)_minmax(0,3fr)]"
        >
          <Tile
            tone="pink"
            class="flex items-baseline justify-between gap-4 self-start lg:sticky lg:top-6 lg:min-h-[9rem] lg:flex-col lg:justify-between"
          >
            <h2
              id={`year-${yearGroup.data.year}`}
              class="font-display tabular text-stat leading-none font-extrabold tracking-[-0.03em]"
            >
              {yearGroup.data.year}
            </h2>
            <p class="text-caption font-semibold">
              {talks.length} {talks.length === 1 ? "talk" : "talks"}
            </p>
          </Tile>

          <div class="grid gap-3 sm:grid-cols-2 md:gap-5">
            {talks.map((event, index) => {
              const youtubeThumbnail = getYoutubeThumbnail(event.video ?? "");
              const primaryLink = event.video ?? event.cta?.[0]?.url;
              const hasThumbnail = !!(
                event.thumbnail ||
                (event.video && youtubeThumbnail)
              );
              const isWide =
                talks.length % 2 === 1 && index === talks.length - 1;

              return (
                <Tile
                  as="article"
                  class:list={[
                    "group flex flex-col gap-3 p-0 md:p-0",
                    isWide && "sm:col-span-2 sm:grid sm:grid-cols-2 sm:items-start sm:gap-0",
                  ]}
                >
                  {primaryLink && (
                    <a
                      href={primaryLink}
                      target="_blank"
                      rel="noopener"
                      class="absolute inset-0 z-0 rounded-[inherit]"
                      aria-label={event.title}
                    />
                  )}
                  {hasThumbnail && (
                    <div
                      class:list={[
                        "bg-muted pointer-events-none relative z-1 aspect-video overflow-hidden",
                        isWide && "sm:m-4 sm:rounded-xl md:m-[18px]",
                      ]}
                    >
                      {event.thumbnail ? (
                        <Image
                          height={360}
                          width={640}
                          alt={event.title}
                          src={ASSET_PREFIX + event.thumbnail}
                          class="size-full object-cover transition-transform duration-500 ease-out-expo group-hover:scale-[1.03]"
                        />
                      ) : (
                        <img
                          src={youtubeThumbnail!}
                          alt={event.title}
                          class="size-full object-cover transition-transform duration-500 ease-out-expo group-hover:scale-[1.03]"
                          loading="lazy"
                          decoding="async"
                        />
                      )}
                      {event.video && (
                        <span class="bg-card text-card-foreground absolute bottom-2.5 left-2.5 inline-flex size-8 items-center justify-center rounded-full">
                          <Icon name="play" class="size-3.5 fill-current" />
                        </span>
                      )}
                    </div>
                  )}
                  {!hasThumbnail && (
                    <div
                      aria-hidden="true"
                      class:list={[
                        "bg-pink text-on-pink pointer-events-none relative z-1 flex aspect-video items-end p-4 md:p-[18px]",
                        isWide && "sm:m-4 sm:rounded-xl md:m-[18px]",
                      ]}
                    >
                      <p class="font-display text-heading leading-tight font-extrabold tracking-[-0.02em]">
                        {event.name}
                      </p>
                    </div>
                  )}
                  <div
                    class:list={[
                      "pointer-events-none relative z-1 flex flex-1 flex-col gap-1.5 px-4 pb-4 md:px-[18px] md:pb-[18px]",
                      isWide && "sm:pt-[18px]",
                    ]}
                  >
                    <h3 class="font-display group-hover:text-primary text-title leading-snug font-bold tracking-[-0.015em] transition-colors">
                      {event.title}
                    </h3>
                    <p class="text-caption font-semibold">
                      {event.name}
                      <time
                        class="text-muted-foreground text-meta mt-0.5 block font-mono font-normal"
                        datetime={new Date(event.date).toISOString().split("T")[0]}
                      >
                        {event.date}
                      </time>
                    </p>
                    <p class="text-muted-foreground text-body leading-relaxed">
                      {event.description}
                    </p>
                    {event.cta && event.cta.length > 0 && (
                      <div class="mt-auto flex flex-wrap gap-1 pt-1.5">
                        {event.cta.map((cta) => (
                          <a
                            href={cta.url}
                            target="_blank"
                            rel="noopener"
                            class="bg-muted hover:bg-foreground hover:text-background pointer-events-auto relative z-2 text-caption inline-flex min-h-8 items-center gap-1 rounded-full px-3 font-semibold transition-colors"
                          >
                            {cta.title}
                            <Icon name="arrow-up-right" class="size-3" />
                          </a>
                        ))}
                      </div>
                    )}
                  </div>
                </Tile>
              );
            })}
          </div>
        </section>
      );
    })
  }
</MainLayout>
